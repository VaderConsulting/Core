#Region " Public Methods "

    Public Sub StopDoubleClick(ByVal WebPage As Web.UI.Page)
        Dim Script As String = ""

        _TraceContext.Write("Inside FMWeb.Functions.StopDoubleClick")

        If (Not WebPage.IsStartupScriptRegistered("NoDoubleClick")) Then

            ' Create script to be registered
            Script = "<script>"
            Script &= "function ImageSwap(img,imgname) {img.src = imgname;}"
            Script &= "   function FreezeScreen(msg) {"
            Script &= "     if (typeof(Page_ClientValidate) == 'function') "
            Script &= "     {"
            Script &= "      if (Page_ClientValidate() == false) { return false; } "
            Script &= "     }"
            Script &= "      scroll(0,0);"
            Script &= "      var outerPane = document.getElementById('FreezePane');"
            Script &= "      var innerPane = document.getElementById('InnerFreezePane');"
            Script &= "      if (outerPane) outerPane.className = 'FreezePaneOn';"
            Script &= "      if (innerPane) innerPane.innerHTML = msg;"
            Script &= "   }"
            Script &= "</script>"
            Script &= "<div align='center' id='FreezePane' class='FreezePaneOff'> <div id='InnerFreezePane' class='InnerFreezePane'> </div></div>"

            _TraceContext.Write("Registering NoDoubleClick script")

            WebPage.RegisterStartupScript("NoDoubleClick", Script)

            For Each FormControl As Control In WebPage.Controls
                If TypeOf FormControl Is System.Web.UI.WebControls.ImageButton Then
                    Dim ThisButton As System.Web.UI.WebControls.ImageButton = DirectCast(FormControl, System.Web.UI.WebControls.ImageButton)

                    If Not (ThisButton.ImageUrl Like "*Download*") Then
                        ThisButton.Attributes.Add("onMouseUp", "FreezeScreen('Page Loading. Please wait...');")
                    End If

                ElseIf TypeOf FormControl Is System.Web.UI.WebControls.DropDownList Then
                    Dim ThisDropDownList As System.Web.UI.WebControls.DropDownList = DirectCast(FormControl, System.Web.UI.WebControls.DropDownList)

                    If ThisDropDownList.AutoPostBack Then
                        ThisDropDownList.Attributes.Add("onChange", "FreezeScreen('Page Loading. Please wait...');")
                    End If

                ElseIf TypeOf FormControl Is System.Web.UI.WebControls.Button Then
                    Dim ThisButton As System.Web.UI.WebControls.Button = DirectCast(FormControl, System.Web.UI.WebControls.Button)

                    ThisButton.Attributes.Add("OnClick", "FreezeScreen('Page Loading. Please wait...');")
                Else
                    ' Other controls we don't want to register.
                End If
                'If FormControl.HasControls() Then
                '    StopDoubleClick(FormControl)
                'End If
            Next
        Else
            ' We don't need to do anything as the script is already registered with this page
            _TraceContext.Write("NoDoubleClick script already registered")
        End If

    End Sub

    Public Function LoadLoginDetails(ByVal Username As String, ByVal SiteID As Int32) As Result
        Dim SelectQuery As String = ""                                                 ' Used to compose the query
        Dim Data As DataSet = Nothing                                                  ' The dataset to base the returned data on
        Dim CollectionResult As Collections.Specialized.NameValueCollection = Nothing  ' The data that will be returned
        Dim ThisResult As New Result                                                   ' The actual object that holds the returned data

        ' Show some tracing info (for debugging purposes later on)
        _TraceContext.Write("Inside FMWeb.Functions.LoadLoginDetails")

        ' Compose the select query
        SelectQuery = "Select * from UserLogin where LoginName = '" & Username & "' AND SiteID = " & SiteID.ToString & " AND EndDate IS NULL"

        ' This is where we perform the database access.
        ' All Core.SQL functions return exceptions to the calling method
        Try
            Data = Core.SQL.Functions.Execute(SelectQuery, _ControlConnectionString)
            CollectionResult = GetCollectionFromDataset(Data)

            ThisResult.ResultType = Result.ReturnType.NameValueCollection
            ThisResult.Result = CollectionResult
            ThisResult.Success = True
        Catch ex As Exception ' Catch any problems.
            ' Tell the calling method that an exception was returned
            ThisResult.ResultType = Result.ReturnType.Exception
            ' Put the exception into the returned object for the calling Method to handle appropriately
            ThisResult.Result = ex
            ' Set a flag so the calling method knows the call did not succeed
            ThisResult.Success = False
        End Try

        ' Cleanup
        Data.Dispose()
        Data = Nothing

        ' Return the custom result type
        Return ThisResult

    End Function

