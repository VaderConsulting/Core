    Private Function GetValueFromCollection(ByVal Name As String, ByVal Collection As Collections.Specialized.NameValueCollection) As String ' Not shared
        _TraceContext.Write("Inside FMWeb.Functions.GetValueFromCollection")

        Try
            Return Collection(Name)
        Catch ex As Exception
            Return ""
        End Try
    End Function

    Private Function IntegerFromString(ByVal InputString As String) As Int32
        Dim Result As Int32 = 0

        If InputString Is Nothing Then
            Result = 0
        Else
            If IsNumeric(InputString) Then
                Result = CInt(InputString)

            Else
                Result = 0

            End If
        End If

        Return Result

    End Function

    Private Sub SetConnectionString()
        If HttpContext.Current.Session("OperationalDB").ToString <> "" Then
            If _ConnectionString = "" Then
                _ConnectionString = HttpContext.Current.Session("OperationalDB").ToString
            End If
        End If

        _TraceContext.Write("Connection String", _ConnectionString)
        _TraceContext.Write("Control Connection String", _ControlConnectionString)

    End Sub

    Private Sub SetSessionVariablesFromLogin(ByVal Account As LoginDTO, ByVal Username As String)
        If Not _Session Is Nothing Then
            _Session("ClientID") = Account.ClientID.ToString
            _Session("UserID") = Account.UserID.ToString
            _Session("UserRole") = Account.UserRoleID.ToString
            _Session("UsersName") = Username.ToString
            _Session("LoginID") = Account.LoginID.ToString
            _Session("_MarkupSecurity") = Account.MarkupSecurity.ToString ' The underscore is from the original project
            _Session("_MarkupDisplay") = Account.MarkupDisplay.ToString   ' The underscore is from the original project

            _TraceContext.Write("Session variables now set")
        Else
            _TraceContext.Write("Session is undefined!")
        End If
    End Sub

    Private Sub UpdateLastLogonInfo(ByVal Account As LoginDTO, ByVal IPAddress As String, ByVal Referrer As String)
        Dim Query As String = ""

        _TraceContext.Write("Updating UserLogin table")
        Query = "UPDATE UserLogin SET LastLogin = GetDate() WHERE LoginID = '" & Account.LoginID.ToString & "' AND EndDate IS NULL"
        Core.SQL.Functions.ExecuteNonQuery(Query, _ControlConnectionString)

        _TraceContext.Write("Updating LoginLog table")
        Query = "INSERT INTO LoginLog (UserID, LoginID, SiteID, ClientID, OrgUnitID, LoginDate, IPAddress, ReferringPage) VALUES('" & Account.UserID.ToString & "', '" & Account.LoginID & "', " & Account.SiteID.ToString & ", " & Account.ClientID & "," & Account.OrgUnitID.ToString & " ,GetDate(),'" & IPAddress & "','" & Referrer & "')"
        Core.SQL.Functions.ExecuteNonQuery(Query, _ControlConnectionString)
    End Sub

#End Region

End Class