            ID = Dataset.Tables(0).Rows(0).Item(0)
            _ObjectIsValid = True
        Else
            _ObjectIsValid = False
        End If

        Dataset = Nothing

        Return ID

    End Function

    ''' <summary>
    ''' Retrieve all ServiceProviders in FleetManager
    ''' </summary>
    ''' <returns>Collection of ServiceProvider</returns>
    ''' <remarks></remarks>
    Public Function GetProviderList(ByVal ServiceType As Integer) As Collections.SortedList
        Dim QueryString As String = ""
        Dim Providers As New Collections.SortedList
        Dim UID As Int32 = 0
        Dim Dataset As Dataset

        ' TODO:  Get the correct SQL
        'QueryString = "SELECT isnull(UID,0) as UID,isnull(ProviderName,'') as ProviderName,isnull(ServiceType,0) as ServiceType,isnull(ProviderCode,'') as ProviderCode from ServiceProvider WITH (NOLOCK) where Providercode is not null"
        QueryString = "select isnull(serviceproviderlookup.serviceproviderid,0) as UID, "
        QueryString &= "isnull(ServiceProvider.ProviderName,'') as ProviderName,isnull(ServiceProvider.servicetype,0) as ServiceType, "
        QueryString &= "isnull(serviceproviderlookup.SystemProviderCode,'') as ProviderCode "
        QueryString &= "from serviceproviderlookup "
        QueryString &= "left outer join ServiceProvider on ServiceProvider.uid =REDACTED "
        QueryString &= "where serviceproviderlookup.clientid = " & _ClientID.ToString
        QueryString &= "and ISNULL(ServiceProvider.ServiceType, 0) =" & ServiceType.ToString

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        For Each Record As DataRow In Dataset.Tables(0).Rows
            Dim Carrier As New Provider

            Carrier.UID =REDACTED"UID")
            Carrier.ProviderName = Record("ProviderName")
            Carrier.ServiceType = Record("ServiceType")
            Carrier.ProviderCode = Record("ProviderCode")

            Providers.Add(Providers.Count + 1, Carrier)
        Next

        Dataset = Nothing

        Return Providers
    End Function

