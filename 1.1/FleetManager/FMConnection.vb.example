        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            ChangeUID =REDACTED
        End If

        ' 2. Get ID of existing Organisational Unit.
        OriginalOU_UID =REDACTED

        ' 3. Modify existing Organisational Unit - set ChangeID.
        ' 4. Modify existing Organisational Unit - set EndDate to today.
        QueryString = "UPDATE ClientOrganisationUnit SET ChangeID = " & ChangeUID & ", EndDate=GETDATE() WHERE (UID = "REDACTED")"
        _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        ' 5. Copy old record as new record.  First select a single record to get the list of columns.
        'QueryString = "SELECT TOP 1 * FROM ClientOrganisationUnit WITH (NOLOCK)" ' WHERE UID ="REDACTED" DK Changes (1) = 1 to fix SQL Error 9/12/2009

        Select Case _SQLVersion
            Case "8" '       SQL Server 2000
                QueryString = "SELECT TOP 1 * FROM ClientOrganisationUnit WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"
            Case "9", "10" ' SQL Server 2005 and 2008
                QueryString = "SELECT TOP (1) * FROM ClientOrganisationUnit WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"
            Case Else
                QueryString = "SELECT TOP (1) * FROM ClientOrganisationUnit WITH (NOLOCK)"
        End Select

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            Dim ColumnName As String = ""

            ' Go through and build a list of each column name
            For Each Column As DataColumn In Dataset.Tables(0).Columns
                ColumnName = Column.ColumnName
                If ColumnName <> "UID" Then
                    SelectString &= ColumnName & ","
                End If
            Next
        End If

        ' Remove trailing comma
        If SelectString.EndsWith(",") Then SelectString = SelectString.Substring(0, SelectString.Length - 1)

        QueryString = "INSERT INTO ClientOrganisationUnit (" & SelectString & ") SELECT " & SelectString & " FROM ClientOrganisationUnit WHERE UID ="REDACTED" ; SELECT SCOPE_IDENTITY() AS ID"

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            NewOU_UID =REDACTED 0, Dataset.Tables(0).Rows(0).Item(0))
        End If

        ' 6. Update record with new details. 
        ' 7. Set StartDate to now.
        ' 8. Set EndDate to NULL.  
        ' 9. Set ChangeID to NULL.
        QueryString = "UPDATE ClientOrganisationUnit"
        QueryString &= " SET"
        QueryString &= " StartDate = GETDATE()"
        QueryString &= ", EndDate = NULL"
        QueryString &= ", ChangeID = NULL"
        QueryString &= ", OrgUnitName = '" & OU.Name.Replace("'", "''") & "'"
        QueryString &= ", OrgUnitParent = " & OU.ParentOrganisationalUnitID
        QueryString &= ", ClientID = " & OU.ClientID
        QueryString &= ", OrgUnitCostCentre = '" & OU.CostCode.Replace("'", "''") & "'"
        QueryString &= ", OrgUnitOverallBudget = " & OU.Budget
        QueryString &= ", OrgUnitIndividualBudget = " & OU.DefaultPersonBudget
        QueryString &= ", OrgUnitExcludeDirectory = " & Math.Abs(CInt(OU.Silent))
        QueryString &= ", OrgUnitLevel = 1"
        QueryString &= ", Custom1 = '" & OU.Custom1.Replace("'", "''") & "'"
        QueryString &= ", Custom2 = '" & OU.Custom2.Replace("'", "''") & "'"
        QueryString &= ", Custom3 = '" & OU.Custom3.Replace("'", "''") & "'"
        QueryString &= ", Custom4 = '" & OU.Custom4.Replace("'", "''") & "'"
        QueryString &= ", Custom5 = '" & OU.Custom5.Replace("'", "''") & "'"
        QueryString &= ", Custom6 = '" & OU.Custom6.Replace("'", "''") & "'"
        QueryString &= ", Custom7 = '" & OU.Custom7.Replace("'", "''") & "'"
        QueryString &= ", Custom8 = '" & OU.Custom8.Replace("'", "''") & "'"
        QueryString &= ", Custom9 = '" & OU.Custom9.Replace("'", "''") & "'"
        QueryString &= ", Custom10 = '" & OU.Custom10.Replace("'", "''") & "'"
        QueryString &= ", Custom11 = '" & OU.Custom11.Replace("'", "''") & "'"
        QueryString &= ", Custom12 = '" & OU.Custom12.Replace("'", "''") & "'"
        QueryString &= ", Custom13 = '" & OU.Custom13.Replace("'", "''") & "'"
