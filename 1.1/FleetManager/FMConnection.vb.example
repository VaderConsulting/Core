    Public Function ConvertGUIDToString(ByRef GUIDString() As Byte) As String
        Dim ReturnString As String = ""

        Try
            For Count As Int32 = 0 To GUIDString.Length - 1
                ReturnString = ReturnString + Hex(GUIDString(Count))
            Next
        Catch ex As Exception
            ' Hopefully we don't ever get here.  If so, we don't want to die!
        End Try
        Return ReturnString
    End Function

    ''' <summary>
    ''' This function counts the number of bills
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function CountBillsCreated(ByVal Prefix As String) As Int32
        Dim QueryString As String = "select count(*) from " & Prefix & "billdetails"
        Dim DataSet As DataSet
        Dim RecordCount As Int32 = 0

        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If DataSet.Tables(0).Rows.Count > 0 Then
            RecordCount = DataSet.Tables(0).Rows(0).Item(0)
        End If

        DataSet = Nothing

        Return RecordCount
    End Function

    ''' <summary>
    ''' Retrieve Unique ID (UID) of existing BillDetails in Fleetmanager database
    ''' </summary>
    ''' <param name="ClientID"></param>
    ''' <param name="Provider"></param>
    ''' ''' <param name="BillDate"></param>
    ''' <returns>Unique ID (UID) of a Bill</returns>
    ''' <remarks></remarks>
    Public Function GetBillDetailsUID(ByVal ClientID As Int32, ByVal Provider As Int32, ByVal BillDate As DateTime, ByVal Prefix As String) As Int32
        Dim QueryString As String = ""
        Dim BillDateString As String = BillDate.Year & BillDate.Month.ToString.PadLeft(2, "0") & BillDate.Day.ToString.PadLeft(2, "0")
        Dim UID As Int32 = 0
        Dim Dataset As Dataset

        ' TODO:  Get the correct SQL
        QueryString = "SELECT UID FROM " & Prefix & "BillDetails WITH (NOLOCK) WHERE  ProviderID = " & Provider & " and convert(char(8),billdate,112) = '" & BillDateString & "' " & _
        " and ClientID = " & ClientID

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            UID =REDACTED
        End If

        Dataset = Nothing

        Return UID

    End Function

    ''' <summary>
    ''' Retrieve Unique ID (UID) of existing FleetManager Bill
    ''' </summary>
    ''' <param name="GUID"></param>
    ''' <returns>Unique ID (UID) of User</returns>
    ''' <remarks></remarks>
    Private Function GetBillUID(ByVal GUID As String) As Int32
        Dim QueryString As String = ""
        Dim UID As Int32 = 0
        Dim Dataset As Dataset

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        ' TODO:  Get the correct SQL
        QueryString = "SELECT UID FROM Users WITH (NOLOCK) WHERE GenericUID ='" & GUID & "' AND EndDate IS NULL'"

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            UID =REDACTED
            _ObjectIsValid = True
        Else
            _ObjectIsValid = False
        End If

        Dataset = Nothing

        Return UID

    End Function

    ''' <summary>
    ''' Get Call UID from BillData table of Fleetmanager database
    ''' </summary>
    ''' <param name="CallClass"></param>
    ''' <param name="Prefix"></param>
    ''' <returns>Unique ID (UID) of a Call</returns>
    ''' <remarks></remarks>
    Public Function GetCallUID(ByVal CallClass As Calls, ByVal Prefix As String) As Int32
        Dim QueryString As String
        Dim UID As Int32 = 0
        Dim DataSet As DataSet

        QueryString = "Select UID from " & Prefix & "BillData WITH (NOLOCK) where BillID = '" & _
        CallClass.BillID & "' and ClientID = '" & CallClass.ClientID & "' and ServiceID = '" & _
        CallClass.ServiceID & "' and UserID = '" & CallClass.UserID & "' and OrgUnitID = '" & _
        CallClass.OrgUnitID & "' and phoneNO = '" & CallClass.CallNo & "' and callDate = '" & _
        CallClass.Calldate & "' and callTime = " & CallClass.CallTime & " and calltrunk = '" & _
        CallClass.CallTrunk & "' and calltruckgroup = '" & CallClass.CallTruckGroup & "' and accesscode = '" & _
        CallClass.AccessCode & "' and site = '" & CallClass.Site & "'"

        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If DataSet.Tables(0).Rows.Count > 0 Then
            UID =REDACTED
        End If

        DataSet = Nothing

        Return UID

    End Function

    ''' <summary>
    ''' Retrieve all Clients in FleetManager
    ''' </summary>
    ''' <returns>Collection of Client</returns>
    ''' <remarks></remarks>
    Public Function GetClientList() As Collections.SortedList
        Dim QueryString As String = ""
        Dim Clients As New Collections.SortedList
        Dim UID As Int32 = 0
        Dim Dataset As Dataset

        QueryString = "SELECT * from CurrentClientView WITH (NOLOCK)"

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        For Each Record As DataRow In Dataset.Tables(0).Rows
            Dim TheClient As New Client

            TheClient.AccountCode = Record("ClientAccountCode") & ""
            TheClient.BillingContact = Record("BillingContact") & ""
            TheClient.ChangeID = IIf(IsDBNull(Record("ChangeID")), -1, Record("ChangeID"))
            TheClient.ClientManager = Record("STEClientManager") & ""
            TheClient.ClientAdministratorID = IIf(IsDBNull(Record("ClientAdminUserID")), -1, Record("ClientAdminUserID"))
            TheClient.Comments = Record("Comments") & ""
            TheClient.CostCentre = Record("ClientCostCentre") & ""
            TheClient.Custom1 = Record("Custom1") & ""
            TheClient.Custom2 = Record("Custom2") & ""
            TheClient.Custom3 = Record("Custom3") & ""
            TheClient.Custom4 = Record("Custom4") & ""
            TheClient.EmailAddress = Record("Email") & ""
            TheClient.Fax = Record("Fax") & ""
            TheClient.ID = IIf(Record("ClientID"), -1, Record("ClientID"))
            TheClient.Name = Record("ClientName")
            TheClient.Phone = Record("Phone") & ""
            If IsDBNull(Record("StartDate")) Then
                TheClient.StartDate = Date.MinValue
            Else
                TheClient.StartDate = CDate(Record("StartDate"))
            End If
            TheClient.UID =REDACTED"UID")), -1, Record("UID"))

            Clients.Add(Clients.Count + 1, TheClient)
        Next

        Dataset = Nothing

        Return Clients
    End Function

    ''' <summary>
    ''' Retrieve the ClientName based on the Client ID provided
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetClientName(ByVal ClientID As Int32) As String
        Dim QueryString As String
        Dim DataSet As DataSet

        QueryString = "Select isnull(ClientName,'') as ClientName from CurrentClientView where Clientid = " & ClientID.ToString
        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        Return DataSet.Tables(0).Rows(0).Item(0).ToString

    End Function

    ''' <summary>
    ''' Retrieve the ClientName based on the current Client ID
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetClientName() As String
        Return GetClientName(_ClientID)
    End Function

    ''' <summary>
    ''' Retrieves the Email Address of the person to notify the status of the Process.
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetEmailNotification() As String

        Dim EmailAddress As String = ""
        Dim QueryString As String = "select isnull(text1,'') as Text1 from clientfeatures where clientid = " & _ClientID.ToString & " and description = 'Email Notification'"
        Dim DataSet As DataSet

        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If DataSet.Tables(0).Rows.Count > 0 Then
            EmailAddress = DataSet.Tables(0).Rows(0).Item(0)
        End If

        DataSet = Nothing

        Return EmailAddress
    End Function

    ''' <summary>
    ''' This function returns all the graphgroups for a given service type
    ''' </summary>
    ''' <param name="Prefix"></param>
    ''' <returns>ReturnedList</returns>
    ''' <remarks>A. Agustin 16/06/2010</remarks>
    Public Function GetGraphGroups(ByVal Prefix As String) As Collections.SortedList
        Dim DataSet As DataSet
        Dim QueryString As String = ""
        Dim ReturnedList As New Collections.SortedList

        QueryString = "select isnull(UID,0) as UID,isnull(GraphGroup,'') as GraphGroup from " & Prefix & "graphgroups order by uid"
        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        For Each Row As DataRow In DataSet.Tables(0).Rows
            ReturnedList.Add(Row("UID"), Row("GraphGroup"))
        Next

        DataSet = Nothing

        Return ReturnedList
    End Function

    ''' <summary>
    ''' Retrieve ID (ID) of existing FleetManager User
    ''' </summary>
    ''' <param name="User"></param>
    ''' <returns>ID of User</returns>
    ''' <remarks></remarks>
    Public Function GetID(ByVal User As Person) As Int32

        If User.GUID.Trim.Length = 0 Then
            Return GetPersonID(User.FirstName, User.Surname)
        Else
            Return GetPersonID(User.GUID)
        End If

    End Function

    ''' <summary>
    ''' Retrieve ID (ID) of existing FleetManager User
    ''' </summary>
    ''' <param name="ParameterName"></param>
    ''' <param name="ParameterValue"></param>
    ''' <param name="ParameterIsString"></param>
    ''' <returns>ID of User</returns>
    ''' <remarks></remarks>
    Public Function GetID(ByVal ObjectType As FleetManagerObjectType, ByVal ParameterName As String, ByVal ParameterValue As String, ByVal ParameterIsString As Boolean) As Int32

        Select Case ObjectType
            Case FleetManagerObjectType.Asset
                Throw New NotImplementedException("GetID(FleetManagerObjectType.Asset) is not implemented")
            Case FleetManagerObjectType.Logon
                Throw New NotImplementedException("GetID(FleetManagerObjectType.Logon) is not implemented")
            Case FleetManagerObjectType.OrganisationUnit
                'Return GetorganisationunitID(ParameterName, ParameterValue, ParameterIsString)
                Throw New NotImplementedException("GetID(FleetManagerObjectType.OrganisationUnit) is not implemented")
            Case FleetManagerObjectType.Person
                Return GetPersonID(ParameterName, ParameterValue, ParameterIsString)
            Case FleetManagerObjectType.Phone
                'Return GetPhoneID(ParameterName, ParameterValue, ParameterIsString)
                Throw New NotImplementedException("GetID(FleetManagerObjectType.Phone) is not implemented")
        End Select


        'If User.GUID.Trim.Length = 0 Then
        '    Return GetPersonID(User.FirstName, User.Surname)
        'Else
        '    Return GetPersonID(User.GUID)
        'End If

    End Function

    ''' <summary>
    ''' Retrieve Unique ID (UID) of existing FleetManager Service
    ''' </summary>
    ''' <param name="Service"></param>
    ''' <returns>Unique ID (UID) of Service</returns>
    ''' <remarks></remarks>
    Public Function GetID(ByVal Service As Phone) As Int32
        If Service.Number.Length > 0 Then
            Return GetPhoneID(Service.Number)
        ElseIf Service.UID > 0 Then
            Return GetPhonebyUID(CStr(Service.UID)).ID
        ElseIf Service.ID > 0 Then
            Return Service.ID
        Else
            Return 0
        End If

    End Function

    ''' <summary>
    ''' Retrieve ID of existing FleetManager OU
    ''' </summary>
    ''' <param name="OU"></param>
    ''' <returns>ID of OU</returns>
    ''' <remarks></remarks>
    Public Function GetID(ByVal OU As OrganisationalUnit) As Int32

        If OU.ParentOrganisationalUnitID > 0 And OU.Name.Length > 0 Then
            Return GetOrganisationalUnitID(OU.Name, OU.ParentOrganisationalUnitID)
        ElseIf OU.GUID.Trim.Length > 0 Then
            Return GetOrganisationalUnitID(OU.GUID, Parameter.GUID)
        ElseIf OU.CostCode.Trim.Length > 0 Then
            Return GetOrganisationalUnitID(OU.CostCode, Parameter.CostCode)
        ElseIf OU.ParentOrganisationalUnitID = 0 And OU.Name.Length > 0 Then
            Return GetOrganisationalUnitID(OU.Name, OU.ParentOrganisationalUnitID)
        Else
            Return 0
        End If

    End Function

    ''' <summary>
    ''' Retrieve ID (ID) of existing FleetManager Login
    ''' </summary>
    ''' <param name="User"></param>
    ''' <returns>ID of Login</returns>
    ''' <remarks></remarks>
    Public Function GetID(ByVal User As Login) As Int32
