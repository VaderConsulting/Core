    ''' <remarks></remarks>
    Private Function GetOrganisationalUnitUID(ByVal GUID As String) As Int32
        Dim QueryString As String = ""
        Dim ID As Int32 = 0
        Dim Dataset As Dataset

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        QueryString = "SELECT UID FROM CurrentClientOrganisationUnitView WITH (NOLOCK) WHERE GenericUID ='" & GUID & "' AND ClientID = " & _ClientID

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            ID = Dataset.Tables(0).Rows(0).Item(0)
            _ObjectIsValid = True
            'trace.writeline("...Found the OU")
        Else
            _ObjectIsValid = False
            'trace.writeline("...No OU Found")
        End If

        Dataset = Nothing

        Return ID

    End Function

    ''' <summary>
    ''' Retrieve all OrganisationUnits in FleetManager
    ''' </summary>
    ''' <returns>Collection of OrganisationUnits</returns>
    ''' <remarks></remarks>
    Public Function GetOrganisationUnits() As Collections.SortedList
        Dim QueryString As String = ""
        Dim ReturnedCollection As New Collections.SortedList
        Dim UID As Int32 = 0
        Dim Dataset As Dataset

        QueryString = "SELECT * FROM CurrentClientOrganisationUnitView WITH (NOLOCK) WHERE ClientID = " & _ClientID.ToString

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        For Each Record As DataRow In Dataset.Tables(0).Rows
            Dim OU As New OrganisationalUnit(_ClientID)
            Dim RowCounter As Integer = 0

            OU.ChangeID = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("ChangeID")), 0, Dataset.Tables(0).Rows(RowCounter).Item("ChangeID"))
            OU.ClientID = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("ClientID")), 0, Dataset.Tables(0).Rows(RowCounter).Item("ClientID"))
            OU.CostCode = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("OrgUnitCostCentre")), "", Dataset.Tables(RowCounter).Rows(RowCounter).Item("OrgUnitCostCentre"))
            OU.Country = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("OrgUnitCountry")), "", Dataset.Tables(0).Rows(RowCounter).Item("OrgUnitCountry"))
            OU.Custom1 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom1")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom1"))
            OU.Custom2 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom2")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom2"))
            OU.Custom3 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom3")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom3"))
            OU.Custom4 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom4")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom4"))
            OU.Custom5 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom5")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom5"))
            OU.Custom6 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom6")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom6"))
            OU.Custom7 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom7")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom7"))
            OU.Custom8 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom8")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom8"))
            OU.Custom9 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom9")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom9"))
            OU.Custom10 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom10")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom10"))
            OU.Custom11 = IIf(IsDBNull(Dataset.Tables(0).Rows(RowCounter).Item("Custom11")), "", Dataset.Tables(0).Rows(RowCounter).Item("Custom11"))
