        QueryString &= ", Custom17 = '" & OU.Custom17.Replace("'", "''") & "'"
        QueryString &= ", Custom18 = '" & OU.Custom18.Replace("'", "''") & "'"
        QueryString &= ", Custom19 = '" & OU.Custom19.Replace("'", "''") & "'"
        QueryString &= ", Custom20 = '" & OU.Custom20.Replace("'", "''") & "'"
        QueryString &= ", RebillingPlanId = " & OU.RebillingPlanID
