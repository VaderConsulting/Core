            DataCommand.Parameters("@theYear").Value = Charge.Billdate.Year
            DataCommand.Parameters("@theYear").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@billDate", SqlDbType.DateTime)
            DataCommand.Parameters("@billDate").Value = Charge.Billdate
            DataCommand.Parameters("@billDate").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@billingCodeID", SqlDbType.Int)
            DataCommand.Parameters("@billingCodeID").Value = Charge.BillingCodeId
            DataCommand.Parameters("@billingCodeID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@providerID", SqlDbType.Int)
            DataCommand.Parameters("@providerID").Value = Charge.ProviderID
            DataCommand.Parameters("@providerID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@offeringID", SqlDbType.Int)
            DataCommand.Parameters("@offeringID").Value = Charge.OfferingID
            DataCommand.Parameters("@offeringID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@graphGroupID", SqlDbType.Int)
            DataCommand.Parameters("@graphGroupID").Value = Charge.GraphGroupID
            DataCommand.Parameters("@graphGroupID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@ChargeDate", SqlDbType.DateTime)
            DataCommand.Parameters("@ChargeDate").Value = Charge.Billdate
            DataCommand.Parameters("@ChargeDate").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@ChargeType", SqlDbType.Char, 150)
            DataCommand.Parameters("@ChargeType").Value = Charge.ChargeType
            DataCommand.Parameters("@ChargeType").Direction = ParameterDirection.Input

            _Database.ExecuteStoredProcedure(DataCommand, Definitions.FleetManagerDatabaseType.Data)

            DataCommand.Dispose()

        Catch ex As Exception
            Err.Raise(vbObjectError + 522, GetExecutingAssembly.GetName.Name, "Failed to insert a record in Service Data." & _
                     ControlChars.Lf & ControlChars.Lf & ex.ToString)
            IsSuccessful = False
        End Try

        Return IsSuccessful
    End Function

    ''' <summary>
    ''' Insert Bill into FleetManager Database
    ''' </summary>
    ''' <returns>Unique ID (UID) of new Bill</returns>
    ''' <remarks></remarks>
    ''' 
    Public Function Insert(ByVal PhoneBill As Bill) As Int32
        Dim ProcedureName As String = PhoneBill.ServiceDescription & "AddBill"
        Dim UID As Int32 = 0

        Try
            Dim DataCommand As SqlClient.SqlCommand
            DataCommand = New SqlClient.SqlCommand(ProcedureName)

            DataCommand.CommandTimeout = 300
            'create the bill and set the billid
            DataCommand.CommandType = CommandType.StoredProcedure
            DataCommand.Parameters.Add("@clientID", SqlDbType.Int)
            DataCommand.Parameters("@clientID").Value = ClientID * -1
            DataCommand.Parameters("@clientID").Direction = ParameterDirection.Input
            DataCommand.Parameters.Add("@providerID", SqlDbType.Int)
            DataCommand.Parameters("@providerID").Value = PhoneBill.ProviderID
            DataCommand.Parameters("@providerID").Direction = ParameterDirection.Input
            DataCommand.Parameters.Add("@bMonth", SqlDbType.Int)
            DataCommand.Parameters("@bMonth").Value = PhoneBill.BillDate.Month
            DataCommand.Parameters("@bMonth").Direction = ParameterDirection.Input
            DataCommand.Parameters.Add("@bYear", SqlDbType.Int)
            DataCommand.Parameters("@bYear").Value = PhoneBill.BillDate.Year
            DataCommand.Parameters("@bYear").Direction = ParameterDirection.Input
            DataCommand.Parameters.Add("@bDate", SqlDbType.DateTime)
            DataCommand.Parameters("@bDate").Value = PhoneBill.BillDate
            DataCommand.Parameters("@bDate").Direction = ParameterDirection.Input
            DataCommand.Parameters.Add("@accNo", SqlDbType.VarChar)
            DataCommand.Parameters("@accNo").Value = PhoneBill.AccountNumber
            DataCommand.Parameters("@accNo").Direction = ParameterDirection.Input
            DataCommand.Parameters.Add("@billID", SqlDbType.Int)
            DataCommand.Parameters("@billID").Direction = ParameterDirection.Output

            _Database.ExecuteStoredProcedure(DataCommand, Definitions.FleetManagerDatabaseType.Data)
            UID =REDACTED"@billID").Value
        Catch ex As Exception
            Err.Raise(vbObjectError + 522, GetExecutingAssembly.GetName.Name, "Failed to insert a record in BillDetails." & _
                      ControlChars.Lf & ControlChars.Lf & ex.ToString)
        End Try

        Return UID

    End Function

    ''' <summary>
    ''' Insert Call into FleetManager Database
    ''' </summary>
    ''' <param name="ClientID"></param>
    ''' <returns>Status (if a a record was successfully inserted)</returns>
    ''' <remarks></remarks>
    ''' 
    Public Function InsertCall(ByVal ClientID As String, ByVal Prefix As String, ByVal CallData As Calls, Optional ByVal WithTermCityValue As Boolean = False) As Boolean
        Dim ProcedureName As String = Prefix & "AddCallData"
        Dim IsSuccessful As Boolean = False

        Try
            Dim DataCommand As SqlClient.SqlCommand
            DataCommand = New SqlClient.SqlCommand(ProcedureName)

            DataCommand.CommandType = CommandType.StoredProcedure
            DataCommand.Parameters.Add("@BillID", SqlDbType.Int)
            DataCommand.Parameters("@billID").Value = CallData.BillID
            DataCommand.Parameters("@billID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@clientID", SqlDbType.Int)
            DataCommand.Parameters("@clientID").Value = ClientID
            DataCommand.Parameters("@clientID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@serviceID", SqlDbType.Int)
            DataCommand.Parameters("@serviceID").Value = CallData.ServiceID
            DataCommand.Parameters("@serviceID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@userID", SqlDbType.Int)
            DataCommand.Parameters("@userID").Value = CallData.UserID
            DataCommand.Parameters("@userID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@orgUnitID", SqlDbType.Int)
            DataCommand.Parameters("@orgUnitID").Value = CallData.OrgUnitID
            DataCommand.Parameters("@orgUnitID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@callDate", SqlDbType.Char, 10)
            DataCommand.Parameters("@callDate").Value = CallData.Calldate
            DataCommand.Parameters("@callDate").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@callTime", SqlDbType.Char, 10)
            DataCommand.Parameters("@callTime").Value = CallData.CallTime
            DataCommand.Parameters("@callTime").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@location", SqlDbType.VarChar, 50)
            DataCommand.Parameters("@location").Value = ""
            DataCommand.Parameters("@location").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@TermCity", SqlDbType.VarChar, 50)
            If WithTermCityValue Then
                DataCommand.Parameters("@TermCity").Value = CallData.CallType.Trim.Replace(",", ";").Replace("'", "''")
            Else
                DataCommand.Parameters("@TermCity").Value = ""
            End If
            DataCommand.Parameters("@TermCity").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@duration", SqlDbType.Int)
            DataCommand.Parameters("@duration").Value = CallData.Duration
            DataCommand.Parameters("@duration").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@callType", SqlDbType.Char, 10)
            DataCommand.Parameters("@callType").Value = CallData.CallType.Trim.Replace(",", ";").Replace("'", "''")
            DataCommand.Parameters("@callType").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@peak", SqlDbType.Char, 10)
            DataCommand.Parameters("@peak").Value = ""
            DataCommand.Parameters("@peak").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@serviceNO", SqlDbType.VarChar, 20)
            DataCommand.Parameters("@serviceNO").Value = CallData.ServiceNumber.Trim.Replace(",", ";").Replace("'", "''")
            DataCommand.Parameters("@serviceNO").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@calledNO", SqlDbType.VarChar, 20)
            DataCommand.Parameters("@calledNO").Value = CallData.CallNo.Trim.Replace(",", ";").Replace("'", "''")
            DataCommand.Parameters("@calledNO").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@IDD", SqlDbType.Char, 1)
            DataCommand.Parameters("@IDD").Value = ""
            DataCommand.Parameters("@IDD").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@PARtype", SqlDbType.Int)
            DataCommand.Parameters("@PARtype").Value = CallData.ParType
            DataCommand.Parameters("@PARtype").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@CallDirection", SqlDbType.VarChar, 20)
            DataCommand.Parameters("@CallDirection").Value = ""
            DataCommand.Parameters("@CallDirection").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@CallFlag", SqlDbType.VarChar, 12)
            DataCommand.Parameters("@CallFlag").Value = CallData.CallFlag
            DataCommand.Parameters("@CallFlag").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@State", SqlDbType.VarChar, 40)
            DataCommand.Parameters("@State").Value = ""
            DataCommand.Parameters("@State").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@Country", SqlDbType.VarChar, 40)
            DataCommand.Parameters("@Country").Value = ""
            DataCommand.Parameters("@Country").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@CallTrunk", SqlDbType.VarChar, 16)
            DataCommand.Parameters("@CallTrunk").Value = CallData.CallTrunk
            DataCommand.Parameters("@CallTrunk").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@CallTruckGroup", SqlDbType.VarChar, 26)
            DataCommand.Parameters("@CallTruckGroup").Value = CallData.CallTruckGroup
            DataCommand.Parameters("@CallTruckGroup").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@Accountcode", SqlDbType.VarChar, 16)
            DataCommand.Parameters("@Accountcode").Value = CallData.AccountCode
            DataCommand.Parameters("@Accountcode").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@Authorisationcode", SqlDbType.VarChar, 16)
            DataCommand.Parameters("@Authorisationcode").Value = CallData.AuthorisationCode
            DataCommand.Parameters("@Authorisationcode").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@RateType", SqlDbType.VarChar, 10)
            DataCommand.Parameters("@RateType").Value = CallData.Raretype
            DataCommand.Parameters("@RateType").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@Accesscode", SqlDbType.VarChar, 5)
            DataCommand.Parameters("@Accesscode").Value = CallData.AccessCode
            DataCommand.Parameters("@Accesscode").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@Transferredcallid", SqlDbType.Int)
            DataCommand.Parameters("@Transferredcallid").Value = 0
            DataCommand.Parameters("@Transferredcallid").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@Answerdelay", SqlDbType.Int)
            DataCommand.Parameters("@Answerdelay").Value = CallData.AnswerDelay
            DataCommand.Parameters("@Answerdelay").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@Answered", SqlDbType.VarChar, 7)
            DataCommand.Parameters("@Answered").Value = CallData.Answered
            DataCommand.Parameters("@Answered").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@Site", SqlDbType.VarChar, 50)
            DataCommand.Parameters("@Site").Value = CallData.Site
            DataCommand.Parameters("@Site").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@totalExCharge", SqlDbType.Money)
            DataCommand.Parameters("@totalExCharge").Value = CallData.TotalExcharge
            DataCommand.Parameters("@totalExCharge").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@totalGst", SqlDbType.Money)
            DataCommand.Parameters("@totalGst").Value = CallData.TotalGST
            DataCommand.Parameters("@totalGst").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@totalINCCharge", SqlDbType.Money)
            DataCommand.Parameters("@totalINCCharge").Value = CallData.TotalExcharge + CallData.TotalGST
            DataCommand.Parameters("@totalINCCharge").Direction = ParameterDirection.Input


            DataCommand.Parameters.Add("@originalExCharge", SqlDbType.Money)
            DataCommand.Parameters("@originalExCharge").Value = CallData.TotalExcharge
            DataCommand.Parameters("@originalExCharge").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@originalGst", SqlDbType.Money)
            DataCommand.Parameters("@originalGst").Value = CallData.TotalGST
            DataCommand.Parameters("@originalGst").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@OriginalINCCharge", SqlDbType.Money)
            DataCommand.Parameters("@OriginalINCCharge").Value = CallData.TotalExcharge + CallData.TotalGST
            DataCommand.Parameters("@OriginalINCCharge").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@TheDay", SqlDbType.TinyInt)
            DataCommand.Parameters("@TheDay").Value = IIf(IsDate(CallData.Calldate), CDate(CallData.Calldate).Day, 0)
            DataCommand.Parameters("@TheDay").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@TheMonth", SqlDbType.TinyInt)
            DataCommand.Parameters("@TheMonth").Value = IIf(IsDate(CallData.Calldate), CDate(CallData.Calldate).Month, 0)
            DataCommand.Parameters("@TheMonth").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@TheYear", SqlDbType.SmallInt)
            DataCommand.Parameters("@TheYear").Value = IIf(IsDate(CallData.Calldate), CDate(CallData.Calldate).Year, 0)
            DataCommand.Parameters("@TheYear").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@billingcodeid", SqlDbType.Int)
            DataCommand.Parameters("@billingcodeid").Value = CallData.BillingCodeid
            DataCommand.Parameters("@billingcodeid").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@providerID", SqlDbType.Int)
            DataCommand.Parameters("@providerID").Value = CallData.ProviderID
            DataCommand.Parameters("@providerID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@offeringID", SqlDbType.Int)
            DataCommand.Parameters("@offeringID").Value = 0
            DataCommand.Parameters("@offeringID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@graphGroupid", SqlDbType.Int)
            DataCommand.Parameters("@graphGroupid").Value = CallData.GraphgroupID
            DataCommand.Parameters("@graphGroupid").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@ChargeType", SqlDbType.VarChar, 150)
            DataCommand.Parameters("@ChargeType").Value = CallData.ChargeType.Trim.Replace(",", ";").Replace("'", "''")
            DataCommand.Parameters("@ChargeType").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@dataUsageBytes", SqlDbType.BigInt)
            DataCommand.Parameters("@DataUsageBytes").Value = 0
            DataCommand.Parameters("@DataUsageBytes").Direction = ParameterDirection.Input


            _Database.ExecuteStoredProcedure(DataCommand, Definitions.FleetManagerDatabaseType.Data)
            IsSuccessful = True

        Catch ex As Exception
            Err.Raise(vbObjectError + 523, GetExecutingAssembly.GetName.Name, "Failed to insert a record in BillData." & ControlChars.Lf & _
                      ControlChars.Lf & ex.Message)
            IsSuccessful = False
        End Try

        Return IsSuccessful
    End Function

    Public Function LoadServiceFilterList(ByVal ServiceType As Integer) As DataSet
        Dim DataSet As DataSet
        Dim QueryString As String = ""

        QueryString = "select isnull(FilterLength,0) as FilterLength,isnull(Filter,'') as Filter,isnull(FilterID,0) as FilterID from servicefilter where ServiceType=" + ServiceType.ToString + " and (clientid is null or clientid = " + _ClientID.ToString + ") order by FilterLength desc,isnull(Clientid,9999),Filter"
        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        Return DataSet

    End Function

    ''' <summary>
    ''' This function returns dataset for a given query string
    ''' </summary>
    ''' <param name="QueryString"></param>
    ''' <returns>DataSet</returns>
    ''' <remarks>A. Agustin 16/06/2010</remarks>
    Public Function RetrieveDataToDataSet(ByVal QueryString As String) As DataSet
        Dim DataSet As DataSet
        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        Return DataSet

    End Function

    ''' <summary>
    ''' Update Details of existing FleetManager User
    ''' </summary>
    ''' <param name="User"></param>
    ''' <returns></returns>
    ''' <remarks>Unique ID (UID) of new User</remarks>
    Public Function Update(ByVal User As Person) As Int32
        Dim QueryString As String = ""
        Dim ChangeUID As String = ""
        Dim OriginalUser_UID As Int32 = 0
        Dim NewUser_UID As Int32 = 0
        Dim Dataset As Dataset
        Dim SelectString As String = ""

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        ' 1. Create record in ChangeLog.  Get ID of change.
        QueryString = "INSERT INTO ChangeLog (UserID, Comments, ModifiedTable, ClientID) VALUES (0,'User details updated by " & My.Application.Info.AssemblyName & " (" & My.User.Name & ")', 'Users', " & User.ClientID & ") ; SELECT SCOPE_IDENTITY() AS ID"

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            ChangeUID =REDACTED
        End If

        ' 2. Get UID of existing user.
        If User.GUID.Trim.Length = 0 Then
            OriginalUser_UID =REDACTED User.Surname)
        Else
            OriginalUser_UID =REDACTED
        End If

        'OriginalUser_UID =REDACTED

        ' 3. Modify existing user - set ChangeID.
        ' 4. Modify existing user - set EndDate to today.
        QueryString = "UPDATE Users SET ChangeID = " & ChangeUID & ", EndDate=GETDATE() WHERE (UID = "REDACTED")"
        _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        ' 5. Copy old record as new record.

        Select Case _SQLVersion
            Case "8" '       SQL Server 2000
                QueryString = "SELECT TOP 1 * FROM Users WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"
            Case "9", "10" ' SQL Server 2005 and 2008
                QueryString = "SELECT TOP (1) * FROM Users WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"
            Case Else
                QueryString = "SELECT TOP (1) * FROM Users WITH (NOLOCK)"
        End Select

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            Dim ColumnName As String = ""

            ' Go through and build a list of each column name
            For Each Column As DataColumn In Dataset.Tables(0).Columns
                ColumnName = Column.ColumnName
                If ColumnName <> "UID" Then
                    SelectString &= ColumnName & ","
                End If
            Next
        End If

        ' Remove trailing comma
        If SelectString.EndsWith(",") Then SelectString = SelectString.Substring(0, SelectString.Length - 1)

        QueryString = "INSERT INTO Users (" & SelectString & ") SELECT " & SelectString & " FROM Users WHERE UID ='" & OriginalUser_UID & "' ; SELECT SCOPE_IDENTITY() AS ID"

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            NewUser_UID =REDACTED 0, Dataset.Tables(0).Rows(0).Item(0))
        End If

        ' 6. Update record with new details. 
        ' 7. Set StartDate to now.
        ' 8. Set EndDate to NULL.  
        ' 9. Set ChangeID to NULL.
        QueryString = "UPDATE Users"
        QueryString &= " SET"
        QueryString &= " StartDate = GETDATE()"
        QueryString &= ", EndDate = NULL"
        QueryString &= ", ChangeID = NULL"
        QueryString &= ", FirstName = '" & User.FirstName.Replace("'", "''") & "'"
        QueryString &= ", LastName = '" & User.Surname.Replace("'", "''") & "'"
        QueryString &= ", ClientID = " & User.ClientID
        QueryString &= ", LocationBuilding = '" & User.Building.Replace("'", "''") & "'"
        QueryString &= ", Status = " & User.Status
        QueryString &= ", Email = '" & User.EmailAddress.Replace("'", "''") & "'"
        QueryString &= ", OrgUnitID = '" & User.OrganisationalUnitID & "'"
        QueryString &= ", PositionTitle = '" & User.Title.Replace("'", "''") & "'"
        QueryString &= ", CostCode = '" & User.CostCode.Replace("'", "''") & "'"
        QueryString &= ", Budget = " & User.Budget
        QueryString &= ", ListInDirectory = " & Math.Abs(CInt((Not User.Silent)))
        QueryString &= ", Custom1 = '" & User.Custom1.Replace("'", "''") & "'"
        QueryString &= ", Custom2 = '" & User.Custom2.Replace("'", "''") & "'"
        QueryString &= ", Custom3 = '" & User.Custom3.Replace("'", "''") & "'"
        QueryString &= ", Custom4 = '" & User.Custom4.Replace("'", "''") & "'"
        QueryString &= ", Custom5 = '" & User.Custom5.Replace("'", "''") & "'"
        QueryString &= ", Custom6 = '" & User.Custom6.Replace("'", "''") & "'"
        QueryString &= ", Custom7 = '" & User.Custom7.Replace("'", "''") & "'"
        QueryString &= ", Custom8 = '" & User.Custom8.Replace("'", "''") & "'"
        QueryString &= ", Custom9 = '" & User.Custom9.Replace("'", "''") & "'"
        QueryString &= ", Custom10 = '" & User.Custom10.Replace("'", "''") & "'"
        QueryString &= ", Custom11 = '" & User.Custom11.Replace("'", "''") & "'"
        QueryString &= ", Custom12 = '" & User.Custom12.Replace("'", "''") & "'"
        QueryString &= ", Custom13 = '" & User.Custom13.Replace("'", "''") & "'"
        QueryString &= ", Custom14 = '" & User.Custom14.Replace("'", "''") & "'"
        QueryString &= ", Custom15 = '" & User.Custom15.Replace("'", "''") & "'"
        QueryString &= ", Custom16 = '" & User.Custom16.Replace("'", "''") & "'"
        QueryString &= ", Custom17 = '" & User.Custom17.Replace("'", "''") & "'"
        QueryString &= ", Custom18 = '" & User.Custom18.Replace("'", "''") & "'"
        QueryString &= ", Custom19 = '" & User.Custom19.Replace("'", "''") & "'"
        QueryString &= ", Custom20 = '" & User.Custom20.Replace("'", "''") & "'"

        QueryString &= ", MiddleName = '" & User.MiddleName.Replace("'", "''") & "'"
        QueryString &= ", Salutation = '" & User.Salutation.Replace("'", "''") & "'"
        QueryString &= ", SecondaryContactNumber = '" & User.SecondaryContactNumber.Replace("'", "''") & "'"

        QueryString &= " WHERE UID = '" & NewUser_UID & "'"
        _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        Dataset = Nothing

        Return NewUser_UID
    End Function

    Public Function CountExistingBills(ByVal Prefix As String, ByVal billdate As Date, ByVal Account As String) As Integer
        Dim QueryString As String = ""
        Dim DataSet As DataSet
        Dim RowCount As Integer = 0

        QueryString = "select count(*) from " & Prefix & "billdetails where convert(varchar,billdate,103) = '" & billdate.ToShortDateString & "' and clientid = " & _ClientID
        QueryString &= " and rtrim(AccountNumber) = '" & Account & "'"

        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        RowCount = DataSet.Tables(0).Rows(0).Item(0)

        Return RowCount

    End Function

    ''' <summary>
    ''' Update Details of existing FleetManager User
    ''' </summary>
    ''' <param name="User"></param>
    ''' <returns></returns>
    ''' <remarks>Unique ID (UID) of new User</remarks>
    Public Function Update(ByVal User As Person, ByVal UniqueParameterName As String, ByVal UniqueParameterValue As String, ByVal UniqueParameterIsString As Boolean) As Int32
        Dim QueryString As String = ""
        Dim ChangeUID As String = ""
        Dim OriginalUser_UID As Int32 = 0
        Dim NewUser_UID As Int32 = 0
        Dim Dataset As Dataset
        Dim SelectString As String = ""

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        ' 1. Create record in ChangeLog.  Get ID of change.
        QueryString = "INSERT INTO ChangeLog (UserID, Comments, ModifiedTable, ClientID) VALUES (0,'User details updated by " & My.Application.Info.AssemblyName & " (" & My.User.Name & ")', 'Users', " & User.ClientID & ") ; SELECT SCOPE_IDENTITY() AS ID"

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            ChangeUID =REDACTED
        End If

        ' 2. Get UID of existing user.
        OriginalUser_UID =REDACTED UniqueParameterValue, UniqueParameterIsString)

        ' 3. Modify existing user - set ChangeID.
        ' 4. Modify existing user - set EndDate to today.
        QueryString = "UPDATE Users SET ChangeID = " & ChangeUID & ", EndDate=GETDATE() WHERE (UID = "REDACTED")"
        _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        ' 5. Copy old record as new record.

        Select Case _SQLVersion
            Case "8" '       SQL Server 2000
                QueryString = "SELECT TOP 1 * FROM Users WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"
            Case "9", "10" ' SQL Server 2005 and 2008
                QueryString = "SELECT TOP (1) * FROM Users WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"
            Case Else
                QueryString = "SELECT TOP (1) * FROM Users WITH (NOLOCK)"
        End Select

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            Dim ColumnName As String = ""

            ' Go through and build a list of each column name
            For Each Column As DataColumn In Dataset.Tables(0).Columns
                ColumnName = Column.ColumnName
                If ColumnName <> "UID" Then
                    SelectString &= ColumnName & ","
                End If
            Next
        End If

        ' Remove trailing comma
        If SelectString.EndsWith(",") Then SelectString = SelectString.Substring(0, SelectString.Length - 1)

        QueryString = "INSERT INTO Users (" & SelectString & ") SELECT " & SelectString & " FROM Users WHERE UID ='" & OriginalUser_UID & "' ; SELECT SCOPE_IDENTITY() AS ID"

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            NewUser_UID =REDACTED 0, Dataset.Tables(0).Rows(0).Item(0))
        End If

        ' 6. Update record with new details. 
        ' 7. Set StartDate to now.
        ' 8. Set EndDate to NULL.  
        ' 9. Set ChangeID to NULL.
        QueryString = "UPDATE Users"
        QueryString &= " SET"
        QueryString &= " StartDate = GETDATE()"
        QueryString &= ", EndDate = NULL"
        QueryString &= ", ChangeID = NULL"
        QueryString &= ", FirstName = '" & User.FirstName.Replace("'", "''") & "'"
        QueryString &= ", LastName = '" & User.Surname.Replace("'", "''") & "'"
        QueryString &= ", ClientID = " & User.ClientID
        QueryString &= ", LocationBuilding = '" & User.Building.Replace("'", "''") & "'"
        QueryString &= ", Status = " & User.Status
        QueryString &= ", Email = '" & User.EmailAddress.Replace("'", "''") & "'"
        QueryString &= ", OrgUnitID = '" & User.OrganisationalUnitID & "'"
        QueryString &= ", PositionTitle = '" & User.Title.Replace("'", "''") & "'"
        QueryString &= ", CostCode = '" & User.CostCode.Replace("'", "''") & "'"
        QueryString &= ", Budget = " & User.Budget
        QueryString &= ", ListInDirectory = " & Math.Abs(CInt((Not User.Silent)))
        QueryString &= ", Custom1 = '" & User.Custom1.Replace("'", "''") & "'"
        QueryString &= ", Custom2 = '" & User.Custom2.Replace("'", "''") & "'"
        QueryString &= ", Custom3 = '" & User.Custom3.Replace("'", "''") & "'"
        QueryString &= ", Custom4 = '" & User.Custom4.Replace("'", "''") & "'"
        QueryString &= ", Custom5 = '" & User.Custom5.Replace("'", "''") & "'"
        QueryString &= ", Custom6 = '" & User.Custom6.Replace("'", "''") & "'"
        QueryString &= ", Custom7 = '" & User.Custom7.Replace("'", "''") & "'"
        QueryString &= ", Custom8 = '" & User.Custom8.Replace("'", "''") & "'"
        QueryString &= ", Custom9 = '" & User.Custom9.Replace("'", "''") & "'"
        QueryString &= ", Custom10 = '" & User.Custom10.Replace("'", "''") & "'"
        QueryString &= ", Custom11 = '" & User.Custom11.Replace("'", "''") & "'"
        QueryString &= ", Custom12 = '" & User.Custom12.Replace("'", "''") & "'"
        QueryString &= ", Custom13 = '" & User.Custom13.Replace("'", "''") & "'"
        QueryString &= ", Custom14 = '" & User.Custom14.Replace("'", "''") & "'"
        QueryString &= ", Custom15 = '" & User.Custom15.Replace("'", "''") & "'"
        QueryString &= ", Custom16 = '" & User.Custom16.Replace("'", "''") & "'"
        QueryString &= ", Custom17 = '" & User.Custom17.Replace("'", "''") & "'"
        QueryString &= ", Custom18 = '" & User.Custom18.Replace("'", "''") & "'"
        QueryString &= ", Custom19 = '" & User.Custom19.Replace("'", "''") & "'"
        QueryString &= ", Custom20 = '" & User.Custom20.Replace("'", "''") & "'"
        QueryString &= ", MiddleName = '" & User.MiddleName.Replace("'", "''") & "'"
        QueryString &= ", Salutation = '" & User.Salutation.Replace("'", "''") & "'"
        QueryString &= ", SecondaryContactNumber = '" & User.SecondaryContactNumber.Replace("'", "''") & "'"

        QueryString &= " WHERE UID = '" & NewUser_UID & "'"
        _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        Dataset = Nothing

        Return NewUser_UID
    End Function

