    ''' <summary>
    ''' Retrieve Unique ID (UID) of existing FleetManager Login
    ''' </summary>
    ''' <param name="GUID"></param>
    ''' <returns>Unique ID (UID) of Login</returns>
    ''' <remarks></remarks>
    Private Function GetLoginID(ByVal GUID As String) As Int32 ' TODO: Requires testing
        Dim QueryString As String = ""
        Dim LoginID As Int32 = 0
        Dim Dataset As Dataset

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        QueryString = "SELECT LoginID FROM CurrentUserLoginView WITH (NOLOCK) WHERE GenericUID ='" & GUID & "' AND ClientID = " & _ClientID

        Dataset = _Database.Execute(QueryString, Definitions.FleetManagerDatabaseType.Control, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            LoginID = Dataset.Tables(0).Rows(0).Item(0)
            _ObjectIsValid = True
        Else
            _ObjectIsValid = False
        End If

        Dataset = Nothing

        Return LoginID

    End Function

    Public Function GetClientAdminEmailAddress() As String
        Dim QueryString As String
        Dim DataSet As DataSet

        QueryString = "Select isnull(Email,'') as Email from CurrentClientView where Clientid = " & ClientID.ToString
        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        Return DataSet.Tables(0).Rows(0).Item(0).ToString
    End Function

    ''' <summary>
    ''' Retrieve Unique ID (UID) of existing FleetManager Login
    ''' </summary>
    ''' <param name="GUID"></param>
    ''' <returns>Unique ID (UID) of User</returns>
    ''' <remarks></remarks>
    Private Function GetLoginUID(ByVal GUID As String) As Int32
        Dim QueryString As String = ""
        Dim ID As Int32 = 0
        Dim Dataset As Dataset

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        QueryString = "SELECT UID FROM UserLogin WITH (NOLOCK) WHERE GenericUID ='" & GUID & "' AND ClientID = " & _ClientID

        Dataset = _Database.Execute(QueryString, Definitions.FleetManagerDatabaseType.Control, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            ID = Dataset.Tables(0).Rows(0).Item(0)
            _ObjectIsValid = True
        Else
            _ObjectIsValid = False
        End If

        Dataset = Nothing

        Return ID

    End Function

    ''' <summary>
    ''' This function will get the maximum importqueueid in the billdetails table
    ''' </summary>
    ''' <returns>ReturnedValue</returns>
    ''' <remarks>A. Agustin 08/06/2010</remarks>
    Public Function GetMaximumImportQueueID(ByVal Prefix As String) As Int32
        Dim ReturnedValue As Int32 = 99999
        Dim Dataset As Dataset

        Dim QueryString As String = "select max(isnull(importqueueid,0)) as importqueueid from " & Prefix & "billdetails "

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            ReturnedValue = Dataset.Tables(0).Rows(0).Item(0)
        End If


        Return ReturnedValue

    End Function

