            QueryString = "UPDATE Service SET ServiceID = " & ID & " WHERE UID = "REDACTED"'' <summary>
    ''' Insert Organisational Unit into FleetManager Database
    ''' </summary>
    ''' <param name="OU"></param>
    ''' <returns>Unique ID (UID) of new OU</returns>
    ''' <remarks></remarks>
    Public Function Insert(ByVal OU As OrganisationalUnit) As Int32
        Dim QueryString As String = "INSERT INTO ClientOrganisationUnit"
        Dim ID As Int32 = 0
        Dim ParentID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        If OU.ParentOrganisationalUnitID = 0 Then
            If OU.ParentOrganisationalUnitGUID <> "" Then
                'trace.writeline("Loading Parent OU ID...")
                ParentID = GetOrganisationalUnitID(OU.ParentOrganisationalUnitGUID, Parameter.GUID)
            Else
                'trace.writeline("This OU has no Parent...")
                ParentID = 0
            End If
        Else
            'trace.writeline("Loading Parent OU ID...")
            ParentID = OU.ParentOrganisationalUnitID
        End If

        OU.CostCode = OU.CostCode & ""

        QueryString &= " (" & _
                       "StartDate," & _
                       "OrgUnitID," & _
                       "EndDate," & _
                       "ChangeID," & _
                       "OrgUnitName," & _
                       "OrgUnitParent," & _
                       "ClientID," & _
                       "OrgUnitCostCentre," & _
                       "OrgUnitOverallBudget," & _
                       "OrgUnitIndividualBudget," & _
                       "OrgUnitExcludeDirectory," & _
                       "OrgUnitLevel," & _
                       "Custom1," & _
                       "Custom2," & _
                       "Custom3," & _
                       "Custom4," & _
                       "Custom5," & _
                       "Custom6," & _
                       "Custom7," & _
                       "Custom8," & _
                       "Custom9," & _
                       "Custom10," & _
                       "Custom11," & _
                       "Custom12," & _
                       "Custom13," & _
                       "Custom14," & _
                       "Custom15," & _
                       "Custom16," & _
                       "Custom17," & _
                       "Custom18," & _
                       "Custom19," & _
                       "Custom20," & _
                       "OrgUnitStreetAddress," & _
                       "OrgUnitSuburb," & _
                       "OrgUnitState," & _
                       "OrgUnitCountry," & _
                       "OrgUnitPostCode," & _
                       "RebillingPlanID," & _
                       "GenericUID) "
        QueryString &= "VALUES     (" & _
                       "cast('" & OU.StartDate & "' as datetime)," & _
                       OU.ID & ", " & _
                       "NULL, " & _
                       "NULL, '" & _
                       OU.Name.Replace("'", "''") & "', " & _
                       ParentID & ", " & _
                       OU.ClientID & ", '" & _
                       OU.CostCode.Replace("'", "''") & "', " & _
                       OU.Budget & ", " & _
                       OU.DefaultPersonBudget & ", " & _
                       Math.Abs(CInt(OU.Silent)) & ", " & _
                       "0, '" & _
                       OU.Custom1.Replace("'", "''") & "', '" & _
                       OU.Custom2.Replace("'", "''") & "', '" & _
                       OU.Custom3.Replace("'", "''") & "', '" & _
                       OU.Custom4.Replace("'", "''") & "', '" & _
                       OU.Custom5.Replace("'", "''") & "', '" & _
                       OU.Custom6.Replace("'", "''") & "', '" & _
                       OU.Custom7.Replace("'", "''") & "', '" & _
                       OU.Custom8.Replace("'", "''") & "', '" & _
                       OU.Custom9.Replace("'", "''") & "', '" & _
                       OU.Custom10.Replace("'", "''") & "', '" & _
                       OU.Custom11.Replace("'", "''") & "', '" & _
                       OU.Custom12.Replace("'", "''") & "', '" & _
                       OU.Custom13.Replace("'", "''") & "', '" & _
                       OU.Custom14.Replace("'", "''") & "', '" & _
                       OU.Custom15.Replace("'", "''") & "', '" & _
                       OU.Custom16.Replace("'", "''") & "', '" & _
                       OU.Custom17.Replace("'", "''") & "', '" & _
                       OU.Custom18.Replace("'", "''") & "', '" & _
                       OU.Custom19.Replace("'", "''") & "', '" & _
                       OU.Custom20.Replace("'", "''") & "', '" & _
                       OU.StreetAddress.Replace("'", "''") & "', '" & _
                       OU.Suburb.Replace("'", "''") & "', " & _
                       OU.State & ", '" & _
                       OU.Country.Replace("'", "''") & "', '" & _
                       OU.PostCode.Replace("'", "''") & "', " & _
                       OU.RebillingPlanID & ", '" & _
                       OU.GUID.Replace("'", "''") & _
                       "')"
        QueryString &= "; SELECT SCOPE_IDENTITY() AS ID"

        'trace.writeline("Creating OU...")
        Dim Dataset As Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        If Dataset.Tables(0).Rows.Count > 0 Then
            ID = Dataset.Tables(0).Rows(0).Item(0)
            _ObjectIsValid = True

            'trace.writeline("Updating OrgUnitID...")
            QueryString = "UPDATE ClientOrganisationunit SET OrgUnitID = " & ID & " WHERE UID = "REDACTED"trace.writeline("Setting OU IsDirty = False")
            OU.IsDirty = False
        Else
            _ObjectIsValid = False
        End If

        Return ID

    End Function

    ''' <summary>
    ''' Insert ClientAccounts into FleetManager Database
    ''' </summary>
    ''' <param name="BillingAccount"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function Insert(ByRef BillingAccount As Account) As Boolean
        Dim QueryString As String = ""
        Dim UID As Int32 = 0
        Dim DataSet As DataSet
        Try
            QueryString = "Select AccountNo,isnull(OrgUnitID,0) as OrgUnitID from ClientAccounts WITH (NOLOCK) " & _
                          " where clientID = " & BillingAccount.ClientID.ToString & _
                          " and AccountNo = '" & BillingAccount.AccountNumber & "' " & _
                          " and BillType = " & BillingAccount.BillType.ToString & _
                          " and ProviderID = " & BillingAccount.ProviderID

            DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
            If DataSet.Tables(0).Rows.Count > 0 Then
                BillingAccount.OrgUnitID = DataSet.Tables(0).Rows(0).Item("OrgUnitID")
            Else
                QueryString = "Insert into ClientAccounts(" & _
                                          "ClientID," & _
                                          "AccountNo," & _
                                          "BillType," & _
                                          "ProviderID,OrgUnitID) values(" & _
                                          BillingAccount.ClientID & ",'" & _
                                          BillingAccount.AccountNumber.Replace("'", "''") & "'," & _
                                          BillingAccount.BillType & "," & _
                                          BillingAccount.ProviderID & ",NULL)"

                _Database.ExecuteNonQuery(QueryString, FleetManagerDatabaseType.Data, 300)
            End If

            Return True
        Catch ex As Exception
            Return False
        End Try

    End Function

    ''' <summary>
    ''' Insert Login into FleetManager Database
    ''' </summary>
    ''' <param name="User"></param>
    ''' <returns>ID of new Login </returns>
    ''' <remarks></remarks>
    Public Function Insert(ByVal User As Login) As Int32 ' TODO: Requires testing
        Dim QueryString As String = "INSERT INTO UserLogin"
        Dim ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        QueryString &= " (" & _
                       " LoginID," & _
                       " StartDate," & _
                       " EndDate," & _
                       " SiteID," & _
                       " LoginName," & _
                       " Password," & _
                       " PasswordExp," & _
                       " ClientID," & _
                       " UserID," & _
                       " ChangeID," & _
                       " Home," & _
                       " UserRole," & _
                       " FirstLogin," & _
                       " LastLogin," & _
                       " OrgUnitID," & _
                       " UserActive," & _
                       " Status," & _
                       " PhoneNumber," & _
                       " Mobile," & _
                       " Fax," & _
                       " Email," & _
                       " HideAllocated," & _
                       " RPP," & _
                       " MarkupSecurity," & _
                       " MarkupDisplay," & _
                       " GenericUID)"
        QueryString &= " VALUES     (" & _
                         User.LoginID & "," & _
                         "cast('" & User.StartDate.ToString & "' as datetime), " & _
                         "NULL, " & _
                         User.SiteID & ", '" & _
                         User.LoginName.Replace("'", "''") & "', '" & _
                         User.Password.Replace("'", "''") & "', " & _
                         IIf(User.PasswordExpiryDate.ToString = "1/01/0001 12:00:00 AM", "NULL", "cast('" & User.PasswordExpiryDate.ToString & "' as datetime)") & ", " & _
                         User.ClientID & ", " & _
                         User.UserID & ", " & _
                         User.ChangeID & ", '" & _
                         User.Home.Replace("'", "''") & "', " & _
                         User.UserRoleID & ", " & _
                         Math.Abs(CInt(User.FirstLogin)) & ", " & _
                         "NULL, " & _
                         User.OrgUnitID & ", " & _
                         Math.Abs(CInt(User.UserActive)) & ", " & _
                         User.Status & ", '" & _
                         User.PhoneNumber.Replace("'", "''") & "', '" & _
                         User.MobileNumber.Replace("'", "''") & "', '" & _
                         User.FacsimileNumber.Replace("'", "''") & "', '" & _
                         User.EmailAddress.Replace("'", "''") & "', " & _
                         Math.Abs(CInt(User.HideAllocated)) & ", " & _
                         User.RPP & ", '" & _
                         User.MarkupSecurity.Replace("'", "''") & "', '" & _
                         User.MarkupDisplay.Replace("'", "''") & "', '" & _
                         User.GUID.Replace("'", "''") & _
                         "') "
        QueryString &= " ; SELECT SCOPE_IDENTITY() AS ID"

        Dim Dataset As Dataset = _Database.Execute(QueryString, Definitions.FleetManagerDatabaseType.Control, 300)

        If Dataset.Tables(0).Rows.Count > 0 Then
            ID = Dataset.Tables(0).Rows(0).Item(0)
            _ObjectIsValid = True

            'trace.writeline("Updating UserID...")
            QueryString = "UPDATE UserLogin SET LoginID = " & ID & " WHERE UID = "REDACTED"trace.writeline("Setting OU IsDirty = False")
            User.IsDirty = False
        Else
            _ObjectIsValid = False
        End If

        Return ID

    End Function

    ''' <summary>
    ''' Insert Service Charge into FleetManager Database
    ''' </summary>
    ''' <param name="Charge"></param>
    ''' <returns>Boolean indicating success</returns>
    ''' <remarks></remarks>
    Public Function Insert(ByVal Charge As ServiceCharge) As Boolean
        Dim IsSuccessful As Boolean = True
        Dim UID As Int32 = 0
        Dim ProcedureName As String = Charge.ServiceDescription & "AddServiceData"

        Try
            Dim DataCommand As SqlClient.SqlCommand
            DataCommand = New SqlClient.SqlCommand(ProcedureName)

            DataCommand.CommandTimeout = 1000
            DataCommand.CommandType = CommandType.StoredProcedure

            DataCommand.Parameters.Add("@billID", SqlDbType.Int)
            DataCommand.Parameters("@billID").Value = Charge.BillID
            DataCommand.Parameters("@billID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@ClientID", SqlDbType.Int)
            DataCommand.Parameters("@ClientID").Value = Charge.ClientID
            DataCommand.Parameters("@ClientID").Direction = ParameterDirection.Input

            DataCommand.Parameters.Add("@serviceID", SqlDbType.Int)
