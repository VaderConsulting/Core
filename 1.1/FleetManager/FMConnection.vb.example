        QueryString &= ", OrgUnitPostCode = '" & OU.PostCode.Replace("'", "''") & "'"

        QueryString &= " WHERE UID = "REDACTED"'' <summary>
    ''' Update Details of existing FleetManager Login
    ''' </summary>
    ''' <param name="User"></param>
    ''' <returns></returns>
    ''' <remarks>Unique ID (UID) of new User</remarks>
    Public Function Update(ByVal User As Login) As Int32 ' TODO: Requires testing
        Dim QueryString As String = ""
        Dim ChangeUID As String = ""
        Dim OriginalLogin_UID As Int32 = 0
        Dim NewLogin_UID As Int32 = 0
        Dim Dataset As Dataset
        Dim SelectString As String = ""

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        ' 1. Create record in ChangeLog.  Get ID of change.
        QueryString = "INSERT INTO ChangeLog (UserID, Comments, ModifiedTable, ClientID) VALUES (0,'UserLogin details updated by " & My.Application.Info.AssemblyName & " (" & My.User.Name & ")', 'UserLogin', " & User.ClientID & ") ; SELECT SCOPE_IDENTITY() AS ID"

        Dataset = _Database.Execute(QueryString, Definitions.FleetManagerDatabaseType.Control, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            ChangeUID =REDACTED
        End If

        ' 2. Get UID of existing user.
        OriginalLogin_UID =REDACTED

        ' 3. Modify existing user - set ChangeID.
        ' 4. Modify existing user - set EndDate to today.
        QueryString = "UPDATE UserLogin SET ChangeID = " & ChangeUID & ", EndDate=GETDATE() WHERE (UID = "REDACTED")"
        _Database.Execute(QueryString, Definitions.FleetManagerDatabaseType.Control, 300)

        ' 5. Copy old record as new record.
        'QueryString = "SELECT TOP (1) * FROM UserLogin WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"

        Select Case _SQLVersion
            Case "8" '       SQL Server 2000
                QueryString = "SELECT TOP 1 * FROM UserLogin WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"
            Case "9", "10" ' SQL Server 2005 and 2008
                QueryString = "SELECT TOP (1) * FROM UserLogin WITH (NOLOCK)" ' WHERE UID ='" & OriginalUser_ID & "'"
            Case Else
                QueryString = "SELECT TOP (1) * FROM UserLogin WITH (NOLOCK)"
        End Select

        Dataset = _Database.Execute(QueryString, Definitions.FleetManagerDatabaseType.Control, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            Dim ColumnName As String = ""

            ' Go through and build a list of each column name
            For Each Column As DataColumn In Dataset.Tables(0).Columns
                ColumnName = Column.ColumnName
                If ColumnName <> "UID" Then
                    SelectString &= ColumnName & ","
                End If
            Next
        End If

        ' Remove trailing comma
        If SelectString.EndsWith(",") Then SelectString = SelectString.Substring(0, SelectString.Length - 1)

        QueryString = "INSERT INTO UserLogin (" & SelectString & ") SELECT " & SelectString & " FROM UserLogin WHERE UID ='" & OriginalLogin_UID & "' ; SELECT SCOPE_IDENTITY() AS ID"

        Dataset = _Database.Execute(QueryString, Definitions.FleetManagerDatabaseType.Control, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            NewLogin_UID =REDACTED 0, Dataset.Tables(0).Rows(0).Item(0))
        End If

        ' 6. Update record with new details. 
        ' 7. Set StartDate to now.
        ' 8. Set EndDate to NULL.  
        ' 9. Set ChangeID to NULL.
        QueryString = "UPDATE UserLogin"
        QueryString &= " SET"

        If User.StartDate = Date.MinValue Then
            QueryString &= ", StartDate = NULL"
        Else
            QueryString &= ", StartDate = cast('" & User.StartDate & "' as datetime)"
        End If

        QueryString &= ", EndDate = NULL"
        QueryString &= ", SiteID = " & User.SiteID
        QueryString &= ", LoginName = '" & User.LoginName.Replace("'", "''") & "'"
        QueryString &= ", Password = '" & User.Password.Replace("'", "''") & "'"

        If User.PasswordExpiryDate = Date.MinValue Then
            QueryString &= ", PasswordExp = NULL"
        Else
            QueryString &= ", PasswordExp = cast('" & User.PasswordExpiryDate & "' as datetime)"
        End If

        QueryString &= ", ClientID = " & User.ClientID
        QueryString &= ", UserID = "REDACTED", ChangeID = " & User.ChangeID
        QueryString &= ", Home = '" & User.Home.Replace("'", "''") & "'"
        QueryString &= ", UserRole = " & User.UserRoleID
        QueryString &= ", FirstLogin = " & Math.Abs(CInt(User.FirstLogin))

        If User.LastLogin = Date.MinValue Then
            QueryString &= ", LastLogin = NULL"
        Else
            QueryString &= ", LastLogin = cast('" & User.LastLogin & "' as datetime)"
        End If

        QueryString &= ", OrgUnitID = " & User.OrgUnitID
        QueryString &= ", UserActive = " & Math.Abs(CInt(User.UserActive))
        QueryString &= ", Status = " & User.Status
        QueryString &= ", PhoneNumber = '" & User.PhoneNumber.Replace("'", "''") & "'"
        QueryString &= ", Mobile = '" & User.MobileNumber.Replace("'", "''") & "'"
        QueryString &= ", Fax = '" & User.FacsimileNumber.Replace("'", "''") & "'"
        QueryString &= ", Email = '" & User.EmailAddress.Replace("'", "''") & "'"
        QueryString &= ", HideAllocated = " & Math.Abs(CInt(User.HideAllocated))
        QueryString &= ", RPP = " & User.RPP
        QueryString &= ", MarkupSecurity = '" & User.MarkupSecurity.Replace("'", "''") & "'"
        QueryString &= ", MarkupDisplay = '" & User.MarkupDisplay.Replace("'", "''") & "'"
        QueryString &= ", GenericUID = '" & User.GUID.Replace("'", "''") & "'"
        QueryString &= " WHERE UID = "REDACTED"'' <summary>
    ''' Updates the TotalAmount, GST and TotalAmount + GST columns in BillDetails table
    ''' </summary>
    ''' <param name="UID"></param>
    ''' <param name="Amount"></param>
    ''' <param name="TablePrefix"></param>
    ''' <returns>Status (if a a record was successfully updated)</returns>
    ''' <remarks></remarks>
    Public Function UpdateBillTotal(ByVal UID As Int32, ByVal Amount As Double, ByVal TablePrefix As String, ByVal BillDate As Date) As Boolean
        Dim IsSuccessful As Boolean = False
        Dim QueryString As String
        Dim GSTAmount As Double = Amount * 0.1
        Dim TotalInc As Double = Amount + GSTAmount

        QueryString = "Update " & TablePrefix & "BillDetails set " & _
                      "ExpectedTotalEx = " & Amount & ", " & _
                      "ExpectedGST = " & GSTAmount & ", " & _
                      "ExpectedTotalInc = " & TotalInc & ", " & _
                      "ActualTotalEx = " & Amount & ", " & _
                      "ActualGST = " & GSTAmount & ", " & _
                      "ActualTotalInc = " & TotalInc & ", " & _
                      "DatabaseTotalEx = " & Amount & ", " & _
                      "DatabaseGST = " & GSTAmount & ", " & _
                      "DatabaseTotalInc = " & TotalInc & ", " & _
                      "UploadDate = getdate(), " & _
                      "DateImported = getdate(), " & _
                      "billDay = day(billdate) " & _
                      "where UID = "REDACTED"exec AllCalcPreProcessingOrgUnit_bill @billid = " & UID
            _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

            IsSuccessful = True
        Catch ex As Exception
            IsSuccessful = False
        End Try

        Return IsSuccessful
    End Function

    ''' <summary>
    ''' This procedure will update the last date run of the Rental Bill Importer in the Client Features table
    ''' </summary>
    ''' <remarks>A. Agustin 02/06/2010</remarks>
    Public Function UpdateRentalBillImporterSchedule(ByVal servicetype As Integer) As Boolean
        Dim IsSuccessful As Boolean = True
        Dim SQLString As String = "Update ClientFeatures set Text2 = convert(varchar,getdate(),103) + ' ' + convert(varchar,getdate(),108) where clientid = " & _ClientID.ToString & " and description = 'RentalBillImporterSchedule-" & servicetype.ToString & "'"
        Try
            _Database.Execute(SQLString, FleetManagerDatabaseType.Data, 300)
        Catch ex As Exception
            IsSuccessful = False
        End Try

        Return IsSuccessful

    End Function

    ''' <summary>
    ''' Calls the Findservice Stored procedure in Fleetmanager
    ''' </summary>
    ''' <param name="Bill"></param>
    ''' <param name="ServiceID"></param>
    ''' <param name="UserID"></param>
    ''' <param name="OrgUnitID"></param>
    ''' <remarks></remarks>
    Public Sub FindService(ByVal Bill As Bill, ByRef ServiceID As Int32, ByRef UserID As Int32, ByRef OrgUnitID As Int32, ByVal BillingAccount As Account)
        Dim ProcedureName As String = "FindService"

        Dim DataCommand As SqlClient.SqlCommand
        DataCommand = New SqlClient.SqlCommand(ProcedureName)

        DataCommand.CommandTimeout = 0
        DataCommand.CommandType = CommandType.StoredProcedure

        DataCommand.Parameters.Add("@serviceNo", SqlDbType.Char)
        If Bill.AddSiteCode Then
            If Bill.Site = "" Then
                DataCommand.Parameters("@serviceNo").Value = Bill.Extension
            Else
                DataCommand.Parameters("@serviceNo").Value = Bill.Site & "-" & Bill.Extension
            End If
        Else
            DataCommand.Parameters("@serviceNo").Value = Bill.Extension
        End If

        DataCommand.Parameters("@serviceNo").Direction = ParameterDirection.Input

        DataCommand.Parameters.Add("@clientID", SqlDbType.Int)
        DataCommand.Parameters("@clientID").Value = _ClientID
        DataCommand.Parameters("@clientID").Direction = ParameterDirection.Input

        DataCommand.Parameters.Add("@provider", SqlDbType.Int)
        DataCommand.Parameters("@provider").Value = Bill.ProviderID
        DataCommand.Parameters("@provider").Direction = ParameterDirection.Input

        DataCommand.Parameters.Add("@accountNo", SqlDbType.VarChar)
        DataCommand.Parameters("@accountNo").Value = BillingAccount.AccountNumber
        DataCommand.Parameters("@accountNo").Direction = ParameterDirection.Input

        DataCommand.Parameters.Add("@serviceType", SqlDbType.Int)
        DataCommand.Parameters("@serviceType").Value = Bill.ServiceType
        DataCommand.Parameters("@serviceType").Direction = ParameterDirection.Input

        DataCommand.Parameters.Add("@serviceID", SqlDbType.Int)
        DataCommand.Parameters("@serviceID").Value = 0
        DataCommand.Parameters("@serviceID").Direction = ParameterDirection.Output

        DataCommand.Parameters.Add("@userID", SqlDbType.Int)
        DataCommand.Parameters("@userID").Value = 0
        DataCommand.Parameters("@userID").Direction = ParameterDirection.InputOutput

        DataCommand.Parameters.Add("@orgID", SqlDbType.Int)
        DataCommand.Parameters("@orgID").Value = BillingAccount.OrgUnitID
        DataCommand.Parameters("@orgID").Direction = ParameterDirection.InputOutput

        _Database.ExecuteStoredProcedure(DataCommand, Definitions.FleetManagerDatabaseType.Data)

        ServiceID = DataCommand.Parameters("@serviceID").Value
        UserID =REDACTED"@userID").Value
        OrgUnitID = DataCommand.Parameters("@orgID").Value
    End Sub

    ''' <summary>
    ''' Retrieve BillCode from FleetManager Database
    ''' </summary>
    ''' <param name="CallTypeDest"></param>
    ''' <param name="Prefix"></param>
    ''' <param name="CallType"></param>
    ''' <param name="Billingcodeid"></param>
    ''' <param name="GraphGroupID"></param>
    ''' <remarks>Returns CallType, Billingcodeid, Graphgroupid</remarks>
    Public Sub GetBillCode(ByVal ProviderID As Integer, ByVal CallTypeDest As String, ByVal Prefix As String, ByRef CallType As String, ByRef BillingCodeID As Int32, ByRef GraphGroupID As Int32)
        Dim QueryString As String
        Dim DataSet As DataSet

        QueryString = "SELECT isnull(" & Prefix & "BillingCodes.ID,0) as ID, isnull(" & Prefix & "BillingCodes.GraphGroupID,0) as GraphGroupID, isnull(" & Prefix & "BillingCodes.Description,'') as Description " + _
                "FROM " & Prefix & "BillingCodes WITH (NOLOCK) INNER JOIN " & _
                Prefix & "BillDescriptionLink ON " & Prefix & "BillingCodes.ID = " & Prefix & "BillDescriptionLink.BillingCodeID " & _
                "WHERE (" & Prefix & "BillDescriptionLink.BillDescription = '" + CallTypeDest.ToString.Replace("'", "''") + "' and " & Prefix & "BillDescriptionLink.ServiceProviderID = " & ProviderID.ToString & ")"

        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If DataSet.Tables(0).Rows.Count > 0 Then
            BillingCodeID = DataSet.Tables(0).Rows(0).Item("ID")
            GraphGroupID = DataSet.Tables(0).Rows(0).Item("GraphGroupID")
            CallType = DataSet.Tables(0).Rows(0).Item("Description")
        Else
            QueryString = "SELECT ID, GraphGroupID, Description from " & Prefix & "BillingCodes WITH (NOLOCK) " & _
            " WHERE (serviceProviderID = 0) and (Description = 'Unassigned')"

            DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
            If DataSet.Tables(0).Rows.Count > 0 Then
                BillingCodeID = DataSet.Tables(0).Rows(0).Item("ID")
                GraphGroupID = DataSet.Tables(0).Rows(0).Item("GraphGroupID")
                CallType = DataSet.Tables(0).Rows(0).Item("Description")
            End If
        End If

        DataSet = Nothing
    End Sub

    ''' <summary>
    ''' This procedure will return the OrgUnitDetails such as OrgUnitName and Cost centre for a given OrgUnitID
    ''' </summary>
    ''' <param name="OrgUnitid"></param>
    ''' <param name="OrgUnitName"></param>
    ''' <param name="OrgUnitCostCentre"></param>
    ''' <remarks>A. Agustin 16/06/2010</remarks>
    Public Sub GetOrganisationDetails(ByVal OrgUnitid As Integer, ByRef OrgUnitName As String, ByRef OrgUnitCostCentre As String)
        Dim DataSet As DataSet
        OrgUnitName = ""
        OrgUnitCostCentre = ""


        Dim QueryString As String = "select isnull(OrgUnitName,'') as OrgName,isnull(OrgUnitCostCentre,'') as OrgCostCentre from currentclientorganisationunitview where orgunitid = " & OrgUnitid & " and clientid = " & _ClientID.ToString
        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        If DataSet.Tables(0).Rows.Count > 0 Then
            OrgUnitName = DataSet.Tables(0).Rows(0).Item("OrgName")
            OrgUnitCostCentre = DataSet.Tables(0).Rows(0).Item("OrgCostCentre")
        End If

        DataSet = Nothing

    End Sub

    ''' <summary>
    ''' This procedure will return the Children of an OrgUnit
    ''' </summary>
    ''' <param name="OrgIDs"></param>
    ''' <param name="OrgChildrens"></param>
    ''' <remarks>A. Agustin 16/06/2010</remarks>
    Public Sub GetOrgChildren(ByVal OrgIDs As String, ByRef OrgChildrens As String)
        Dim QueryString As String = ""
        Dim DataSet As DataSet

        QueryString = "Select isnull(OrgUnitID,'') as OrgUnitID,isnull(OrgUnitParent,'') as OrgUnitParent from CurrentClientOrganisationUnitView where "
        QueryString &= "Clientid = " & _ClientID.ToString & " and enddate is null  and OrgUnitParent = " & OrgIDs
        QueryString &= "order by orgunitparent,orgunitid"

        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        For Each Row As DataRow In DataSet.Tables(0).Rows
            If OrgChildrens <> "" Then
                OrgChildrens &= ","
            End If

            OrgChildrens &= Row("OrgUnitID")
            GetOrgChildren(Row("OrgUnitID"), OrgChildrens)
        Next


    End Sub

    ''' <summary>
    ''' Retrieve Unique ID (UID) of existing Provider in Fleetmanager database
    ''' </summary>
    ''' <param name="ProviderCode"></param>
    ''' <param name="ServiceType"></param>
    ''' <remarks></remarks>
    Public Sub GetProvider(ByVal ServiceType As Int32, ByVal ProviderCode As String, ByVal ProviderList As Collections.SortedList, ByRef ProviderID As Int32, ByRef ProviderName As String)
        ProviderID = -1

        For Each KeyItem As String In ProviderList.Keys
            Dim Carrier As Provider = ProviderList(KeyItem)
            If Carrier.ServiceType = ServiceType And Carrier.ProviderName.Trim.ToLower = ProviderCode.Trim.ToLower Then 'CADS3
                ProviderID = Carrier.UID
                ProviderName = Carrier.ProviderName
                Exit For
            End If
        Next

        If ProviderID = -1 Then
            For Each KeyItem As String In ProviderList.Keys
                Dim Carrier As Provider = ProviderList(KeyItem)
                If Carrier.ServiceType = ServiceType And Carrier.ProviderCode.Trim.ToLower = ProviderCode.Trim.ToLower Then 'CADSWin
                    ProviderID = Carrier.UID
                    ProviderName = Carrier.ProviderName
                    Exit For
                End If
            Next
        End If

        If ProviderID = -1 Then ProviderID = 0
    End Sub

    ''' <summary>
    ''' This procedure will get the schedule of the Rental bill Importer
    ''' </summary>
    ''' <remarks>A. Agustin 31/05/2010</remarks>
    Public Sub GetRentalBillSchedule(ByRef LastDateRun As DateTime, ByRef DayRun As Integer, ByVal ServiceType As Integer)

        Try

            Dim SQLString As String = "Select isnull(text1,'') as DayRun, isnull(text2,'') as LastDateRun from ClientFeatures where description = 'RentalBillImporterSchedule-" & ServiceType.ToString & "' and clientid = " & _ClientID.ToString


            Dim Data As DataSet = _Database.Execute(SQLString, FleetManagerDatabaseType.Data, 300)

            If Data.Tables(0).Rows.Count > 0 Then
                If IsNumeric(Data.Tables(0).Rows(0).Item(0)) Then
                    DayRun = CInt(Data.Tables(0).Rows(0).Item(0))
                Else
                    DayRun = 0
                End If

                If IsDate(Data.Tables(0).Rows(0).Item(1)) Then
                    LastDateRun = CDate(Data.Tables(0).Rows(0).Item(1))
                Else
                    LastDateRun = CDate("1/1/1900")
                End If
            End If

        Catch ex As Exception
            Debug.WriteLine("FMConnection. GetRentalBillSchedule.  The error was " & ex.ToString)
        End Try

    End Sub

    ''' <summary>
    ''' This procedure will retrieve the table prefix and description of a given service
    ''' </summary>
    ''' <param name="GUID"></param>
    ''' <param name="TablePrefix"></param>
    ''' <param name="ServiceDescription"></param>
    ''' <remarks></remarks>
    Public Sub GetServiceDescription(ByVal GUID As Int32, ByRef TablePrefix As String, ByRef ServiceDescription As String)
        Dim QueryString As String = ""
        TablePrefix = ""
        ServiceDescription = ""

        Dim Dataset As Dataset

        QueryString = "select isnull(tableprefix,'') as tableprefix,isnull(description,'') as description from servicetype  where UID = "REDACTED"tableprefix")
                ServiceDescription = Dataset.Tables(0).Rows(0).Item("description")
            End If
        Catch ex As Exception
            Err.Raise(vbObjectError + 521, GetExecutingAssembly.GetName.Name, "The Table prefix could not be retrieved from this Service type." & _
                      ControlChars.Lf & ControlChars.Lf & ex.ToString)
        End Try

        Dataset = Nothing

    End Sub

    ''' <summary>
    ''' This procedure will retrieve all the records from CurrentServiceview that have rental charges
    ''' </summary>
    ''' <param name="ServicesWithRentalCharges"></param>
    ''' <remarks>A. Agustin 31/05/2010</remarks>
    Public Sub GetServicesWithRentalCharges(ByRef ServicesWithRentalCharges As DataSet, ByVal ServiceType As Integer, ByVal IncText As String, ByVal ExText As String, ByVal IncludeActiveServicesOnly As Boolean, ByVal Month As Integer, ByVal Year As Integer, ByVal Prefix As String)

        Dim StringCommand As New StringBuilder
        'StringCommand.Append("select  isnull(servicenumber,'') as Servicenumber,isnull(servicetype,0) as Servicetype, ")
        'StringCommand.Append("isnull(ServiceProviderID,0) as ServiceProviderID,isnull(ProviderName,'') as ProviderName, isnull(OrgUnitid,0) as OrgUnitid, isnull(spare3,'') as RentalDescription, ")
        'StringCommand.Append("case (charindex('-',spare3)) when 0  ")
        'StringCommand.Append("then  ")
        'StringCommand.Append("case isnumeric(replace(spare3,'$','')) when 1 then convert(decimal(18,2),replace(spare3,'$','')) else 0.00 end ")
        'StringCommand.Append("else  ")
        'StringCommand.Append("case isnumeric(replace(rtrim(ltrim(substring(spare3,charindex('-',spare3)+1,len(spare3) -charindex('-',spare3)+1))),'$','')) ")
        'StringCommand.Append("when 1 then convert(decimal(18,2),replace(rtrim(ltrim(substring(spare3,charindex('-',spare3)+1,len(spare3) -charindex('-',spare3)+1))),'$','')) ")
        'StringCommand.Append("else 0.00 end ")
        'StringCommand.Append("end  as RentalCharges ")
        'StringCommand.Append("from CurrentServiceview ")
        'StringCommand.Append("where isnull(Spare3,'') <> '' and ClientID = " & _ClientID.ToString & " and ServiceType = " & ServiceType)
        'StringCommand.Append(" and spare3 like '%ex%' ")
        'StringCommand.Append(" order by servicenumber,isnull(spare3,'')")

        ' Select all services with Rental charges taking into account the description in Spare3 column
        ' Spare3 is used to describe service charges

        StringCommand.Append("select convert(decimal(18,2),rtrim(replace(replace(replace(rtrim(ltrim(substring(spare3,charindex('-',spare3)+1,len(spare3) -charindex('-',spare3)+1))),'$',''),'" & ExText & "',''),'" & IncText & "','')) ), ")
        StringCommand.Append("isnull(servicenumber,'') as Servicenumber,isnull(servicetype,0) as Servicetype,  ")
        StringCommand.Append("isnull(ServiceProviderID,0) as ServiceProviderID,isnull(ProviderName,'') as ProviderName, ")
        StringCommand.Append(" isnull(OrgUnitid,0) as OrgUnitid, isnull(spare3,'') as RentalDescription,  ")
        StringCommand.Append("case (charindex('-',spare3))  ")
        StringCommand.Append("when 0   ")
        StringCommand.Append("then   ")
        StringCommand.Append("case isnumeric(replace(spare3,'$',''))  ")
        StringCommand.Append("when 1 then convert(decimal(18,2),replace(spare3,'$',''))  ")
        StringCommand.Append("else 0.00  ")
        StringCommand.Append("end  ")
        StringCommand.Append("else   ")
        StringCommand.Append("case isnumeric(replace(rtrim(ltrim(substring(spare3,charindex('-',spare3)+1,len(spare3) -charindex('-',spare3)+1))),'$',''))  ")
        StringCommand.Append("when 1 then convert(decimal(18,2),replace(rtrim(ltrim(substring(spare3,charindex('-',spare3)+1,len(spare3) -charindex('-',spare3)+1))),'$','')) ")
        StringCommand.Append("else  ")
        StringCommand.Append("case isnumeric(rtrim(replace(replace(replace(rtrim(ltrim(substring(spare3,charindex('-',spare3)+1,len(spare3) -charindex('-',spare3)+1))),'$',''),'" & ExText & "',''),'" & IncText & "',''))) ")
        StringCommand.Append("when 1 then convert(decimal(18,2),rtrim(replace(replace(replace(rtrim(ltrim(substring(spare3,charindex('-',spare3)+1,len(spare3) -charindex('-',spare3)+1))),'$',''),'" & ExText & "',''),'" & IncText & "','')) ) ")
        StringCommand.Append("else 0.00 end ")
        StringCommand.Append("end  ")
        StringCommand.Append("end as RentalCharges  ")
        StringCommand.Append("from CurrentServiceview  ")
        StringCommand.Append("where isnull(Spare3,'') <> '' and ClientID = " & ClientID.ToString & " and ServiceType = " & ServiceType.ToString)

        If IncludeActiveServicesOnly Then
            StringCommand.Append(" and CurrentServiceView.Serviceid in(select serviceid from " & Prefix & "preprocessingservice where billid in(Select uid from " & Prefix & "billdetails where clientid = " & ClientID.ToString & " and billmonth =" & Month.ToString & " and billyear = " & Year.ToString & ") ")
            StringCommand.Append("and totaltransactions > 0 )")
        End If
        StringCommand.Append(" order by servicenumber,isnull(spare3,'') ")


        ServicesWithRentalCharges = _Database.Execute(StringCommand.ToString, FleetManagerDatabaseType.Data, 1000)

    End Sub

    ''' <summary>
    ''' This procedure will retrieve all the records from CurrentServiceview that have rental charges if they have call charges for the given month and year
    ''' </summary>
    ''' <param name="ServicesWithRentalCharges"></param>
    ''' <remarks>D. Robinson 23/03/2011</remarks>
    Public Sub GetServicesWithRentalCharges(ByRef ServicesWithRentalCharges As DataSet, ByVal ServiceType As Integer, ByVal IncText As String, ByVal ExText As String, ByVal BillMonth As Integer, ByVal BillYear As Integer, ByVal ServicePrefix As String)
        Dim StringCommand As New StringBuilder

        ' Select all services with Rental charges taking into account the description in Spare3 column
        ' Spare3 is used to describe service charges

        StringCommand.Append("SELECT     ISNULL(CurrentServiceView.ServiceNumber, '')    AS Servicenumber, ")
        StringCommand.Append("           ISNULL(CurrentServiceView.ServiceProviderID, 0) AS ServiceProviderID, ")
        StringCommand.Append("           ISNULL(CurrentServiceView.ProviderName, '')     AS ProviderName, ")
        StringCommand.Append("           ISNULL(CurrentServiceView.OrgUnitID, 0)         AS OrgUnitid, ")
        StringCommand.Append("           ISNULL(CurrentServiceView.Spare3, '')           AS RentalDescription, ")
        StringCommand.Append("           CASE (charindex('-', spare3)) ")
        StringCommand.Append("               WHEN 0 THEN ")
        StringCommand.Append("                   CASE isnumeric(replace(spare3, '$', '')) ")
        StringCommand.Append("                       WHEN 1 THEN ")
        StringCommand.Append("                           CONVERT(decimal(18, 2), replace(spare3, '$', '')) ")
        StringCommand.Append("                       ELSE ")
        StringCommand.Append("                           0.00 ")
        StringCommand.Append("                       END ")
        StringCommand.Append("               ELSE ")
        StringCommand.Append("                   CASE isnumeric(replace(rtrim(ltrim(substring(spare3, charindex('-', spare3) + 1,len(spare3) - charindex('-', spare3) + 1))), '$', '')) ")
        StringCommand.Append("                       WHEN 1 THEN ")
        StringCommand.Append("                           CONVERT(decimal(18, 2), replace(rtrim(ltrim(substring(spare3, charindex('-', spare3) + 1, len(spare3) - charindex('-', spare3) + 1))), '$', '')) ")
        StringCommand.Append("                       ELSE ")
        StringCommand.Append("                           CASE isnumeric(rtrim(replace(replace(replace(rtrim(ltrim(substring(spare3, charindex('-', spare3) + 1, len(spare3) - charindex('-', spare3) + 1))), '$', ''), '" & ExText & "', ''), '" & IncText & "', ''))) ")
        StringCommand.Append("                           WHEN 1 THEN ")
        StringCommand.Append("                               CONVERT(decimal(18, 2), rtrim(replace(replace(replace(rtrim(ltrim(substring(spare3,charindex('-', spare3) + 1, len(spare3) - charindex('-', spare3) + 1))), '$', ''), '" & ExText & "', ''), '" & IncText & "', ''))) ")
        StringCommand.Append("                           ELSE ")
        StringCommand.Append("                               0.00 ")
        StringCommand.Append("                           END ")
        StringCommand.Append("                       END ")
        StringCommand.Append("               END ")
        StringCommand.Append("                                                           AS RentalCharges")
        StringCommand.Append("FROM       " & ServicePrefix & " & PreProcessingService LEFT OUTER JOIN")
        StringCommand.Append("                      " & ServicePrefix & " & BillDetails ON " & ServicePrefix & " & PreProcessingService.BillID = " & ServicePrefix & " & BillDetails.UID RIGHT OUTER JOIN")
        StringCommand.Append("                      CurrentServiceView ON " & ServicePrefix & " & PreProcessingService.ServiceID = CurrentServiceView.UID")
        StringCommand.Append("WHERE     (ISNULL(CurrentServiceView.Spare3, '') <> '') AND ")
        StringCommand.Append("          (CurrentServiceView.ClientID = " & ClientID.ToString & ") AND ")
        StringCommand.Append("          (CurrentServiceView.ServiceType = " & ServiceType.ToString & ") AND ")
        StringCommand.Append("          (CurrentServiceView.ServiceNumber IN")
        StringCommand.Append("              (SELECT     CurrentServiceView_1.ServiceNumber")
        StringCommand.Append("               FROM       " & ServicePrefix & " & PreProcessingService AS " & ServicePrefix & " & PreProcessingService_1 RIGHT OUTER JOIN")
        StringCommand.Append("                          CurrentServiceView AS CurrentServiceView_1 ON " & ServicePrefix & " & PreProcessingService_1.ServiceID = CurrentServiceView_1.ServiceID")
        StringCommand.Append("               WHERE      (" & ServicePrefix & " & PreProcessingService_1.ClientID = " & ClientID.ToString & ") AND (" & ServicePrefix & " & PreProcessingService_1.TheMonth = " & BillMonth.ToString & ") AND ")
        StringCommand.Append("                          (" & ServicePrefix & " & PreProcessingService_1.TheYear = " & BillYear.ToString & ") AND ")
        StringCommand.Append("                          (" & ServicePrefix & " & PreProcessingService_1.TotalTransactions > 0)))")
        StringCommand.Append("ORDER BY CurrentServiceView.ServiceNumber, RentalDescription")



        ServicesWithRentalCharges = _Database.Execute(StringCommand.ToString, FleetManagerDatabaseType.Data, 1000)

    End Sub

    ''' <summary>
    ''' Get the version of SQL Server in use
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub GetSQLServerVersion()
        Dim SQLString As String = "SELECT substring(cast(SERVERPROPERTY('productversion') as varchar),0,CONVERT(INT,charindex('.',CONVERT(varchar,SERVERPROPERTY('productversion')))))"

        Try
            Dim Data As DataSet = _Database.Execute(SQLString, FleetManagerDatabaseType.Data, 300)

            If Data.Tables(0).Rows.Count > 0 Then
                _SQLVersion = Data.Tables(0).Rows(0).Item(0)
            End If
        Catch ex As Exception
            Debug.WriteLine("Could not determine SQL Version.  The error was " & ex.ToString)
        End Try
    End Sub

    Public Sub GetUTSReportsLocation(ByVal ReportID As Integer, ByVal SubReportID As String, ByRef XMLFile As String, ByRef ReportDestination As String)
        Dim QueryString As String = ""
        Dim DataSet As DataSet

        XMLFile = ""
        ReportDestination = ""

        QueryString = "Select isnull(Custom2,'') as Custom2,isnull(Custom3,'') as Custom3 from ReportTypes where Custom1 = '" & SubReportID & "' and ReportID = " & ReportID.ToString
        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        If DataSet.Tables(0).Rows.Count > 0 Then
            XMLFile = DataSet.Tables(0).Rows(0).Item("Custom2")
            ReportDestination = DataSet.Tables(0).Rows(0).Item("Custom3")
        End If

    End Sub

    Public Sub Initialize(ByVal ClientID As Int32, ByVal Database As FMDatabase)
        If ClientID > 0 Then
            ' TODO:  Search for this clientID.
            _ClientID = ClientID
            _Database = Database
            GetSQLServerVersion()
        Else
            Err.Raise(vbObjectError + 514, GetExecutingAssembly.GetName.Name, "Client ID not specified for FleetManager Connection.")
        End If
    End Sub

    ''' <summary>
    ''' Updates the ClientID to a non negative value in BillDetails table
    ''' </summary>
    ''' <param name="BillsToProcess"></param>
    ''' <param name="Prefix"></param>
    ''' <remarks></remarks>
    Public Sub UpdateBillDetailsClientID(ByVal BillsToProcess As Collections.SortedList, ByVal Prefix As String)
        Dim BillList As String = ""
        Dim QueryString As String = ""

        For Each Item As String In BillsToProcess.Keys
            BillList &= BillsToProcess(Item) & ","
        Next

        If BillList.Length > 0 Then
            BillList = BillList.Substring(0, BillList.Length - 1)

            QueryString = "Update " & Prefix & "BillDetails set " & _
                          "ClientID =  abs(ClientID) " & _
                          "where UID in (" & BillList & ") "

            _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        End If

    End Sub

