Public Class FMConnection

    Private _ClientID As Int32 = 0
    Private _Database As FMDatabase
    Private _ObjectIsValid As Boolean = False
    Private _SQLVersion As String = ""

    Public Enum Parameter As Integer
        GUID =REDACTED
        CostCode = 2
    End Enum

#Region " Properties "

    Public Property ClientID() As Int32
        Get
            Return _ClientID
        End Get
        Set(ByVal value As Int32)
            _ClientID = value
        End Set
    End Property

