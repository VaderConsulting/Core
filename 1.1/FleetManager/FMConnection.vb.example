        QueryString = "SELECT UID FROM CurrentServiceView WITH (NOLOCK) WHERE ServiceNumber ='" & Number.Replace("'", "''") & "' AND ClientID = " & _ClientID

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
