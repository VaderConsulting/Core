    ''' <summary>
    ''' This function will get the path of the rental charges configuration
    ''' </summary>
    ''' <returns>Path</returns>
    ''' <remarks>A. Agustin 31/05/2010</remarks>
    Public Function GetXMLRentalLocation() As String
        Dim Path As String = ""
        Dim QueryString As String = "select isnull(text1,'') as Text1 from clientfeatures where clientid = " & _ClientID.ToString & " and description = 'RentalBillImporter - Configuration'"
        Dim DataSet As DataSet

        DataSet = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If DataSet.Tables(0).Rows.Count > 0 Then
            Path = DataSet.Tables(0).Rows(0).Item(0)
        End If

        DataSet = Nothing

        Return Path
    End Function

