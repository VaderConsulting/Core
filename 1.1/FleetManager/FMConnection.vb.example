    Public Function Insert(ByVal User As Person) As Int32
        Dim QueryString As String = "INSERT INTO Users"
        Dim ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        QueryString &= " (" & _
                       " StartDate," & _
                       " FirstName," & _
                       " LastName," & _
                       " ClientID," & _
                       " LocationBuilding," & _
                       " Status," & _
                       " Email," & _
                       " OrgUnitID," & _
                       " PositionTitle," & _
                       " CostCode," & _
                       " Budget," & _
                       " ListInDirectory," & _
                       " Custom1," & _
                       " Custom2," & _
                       " Custom3," & _
                       " Custom4," & _
                       " Custom5," & _
                       " Custom6," & _
                       " Custom7," & _
                       " Custom8," & _
                       " Custom9," & _
                       " Custom10," & _
                       " Custom11," & _
                       " Custom12," & _
                       " Custom13," & _
                       " Custom14," & _
                       " Custom15," & _
                       " Custom16," & _
                       " Custom17," & _
                       " Custom18," & _
                       " Custom19," & _
                       " Custom20," & _
                       " MiddleName," & _
                       " Salutation," & _
                       " SecondaryContactNumber," & _
                       " GenericUID)"
        QueryString &= " VALUES     (" & _
                         "cast('" & User.StartDate & "' as datetime),'" & _
                         User.FirstName.Replace("'", "''") & "', '" & _
                         User.Surname.Replace("'", "''") & "', '" & _
                         User.ClientID & "', '" & _
                         User.Building.Replace("'", "''") & "', '" & _
                         User.Status & "', '" & _
                         User.EmailAddress.Replace("'", "''") & "', '" & _
                         User.OrganisationalUnitID & "', '" & _
                         User.Title.Replace("'", "''") & "', '" & _
                         User.CostCode.Replace("'", "''") & "', " & _
                         User.Budget & ", " & _
                         Math.Abs(CInt(Not User.Silent)) & ", '" & _
                         User.Custom1.Replace("'", "''") & "', '" & _
                         User.Custom2.Replace("'", "''") & "', '" & _
                         User.Custom3.Replace("'", "''") & "', '" & _
                         User.Custom4.Replace("'", "''") & "', '" & _
                         User.Custom5.Replace("'", "''") & "', '" & _
                         User.Custom6.Replace("'", "''") & "', '" & _
                         User.Custom7.Replace("'", "''") & "', '" & _
                         User.Custom8.Replace("'", "''") & "', '" & _
                         User.Custom9.Replace("'", "''") & "', '" & _
                         User.Custom10.Replace("'", "''") & "', '" & _
                         User.Custom11.Replace("'", "''") & "', '" & _
                         User.Custom12.Replace("'", "''") & "', '" & _
                         User.Custom13.Replace("'", "''") & "', '" & _
                         User.Custom14.Replace("'", "''") & "', '" & _
                         User.Custom15.Replace("'", "''") & "', '" & _
                         User.Custom16.Replace("'", "''") & "', '" & _
                         User.Custom17.Replace("'", "''") & "', '" & _
                         User.Custom18.Replace("'", "''") & "', '" & _
                         User.Custom19.Replace("'", "''") & "', '" & _
                         User.Custom20.Replace("'", "''") & "', '" & _
                         User.MiddleName.Replace("'", "''") & "', '" & _
                         User.Salutation.Replace("'", "''") & "', '" & _
                         User.SecondaryContactNumber.Replace("'", "''") & "', '" & _
                         User.GUID.Replace("'", "''") & _
                         "') "
        QueryString &= " ; SELECT SCOPE_IDENTITY() AS ID"

        Dim Dataset As Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)

        If Dataset.Tables(0).Rows.Count > 0 Then
            ID = Dataset.Tables(0).Rows(0).Item(0)
            _ObjectIsValid = True

            'trace.writeline("Updating UserID...")
            QueryString = "UPDATE Users SET UserID = "REDACTED" WHERE UID = "REDACTED"trace.writeline("Setting OU IsDirty = False")
            User.IsDirty = False
        Else
            _ObjectIsValid = False
        End If

        Return ID

    End Function

