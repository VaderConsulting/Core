    ''' <summary>
    ''' Retrieve ID of existing FleetManager OU
    ''' </summary>
    ''' <param name="Value"></param>
    ''' <returns>ID of OU</returns>
    ''' <remarks></remarks>
    Private Function GetOrganisationalUnitID(ByVal Value As String, ByVal ParameterType As Parameter) As Int32
        Dim QueryString As String = ""
        Dim ID As Int32 = 0
        Dim Dataset As Dataset

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        Select Case ParameterType
            Case Parameter.GUID
                QueryString = "SELECT OrgUnitID FROM CurrentClientOrganisationUnitView WITH (NOLOCK) WHERE GenericUID ='" & Value & "' AND ClientID = " & _ClientID
            Case Parameter.CostCode
                QueryString = "SELECT OrgUnitID FROM CurrentClientOrganisationUnitView WITH (NOLOCK) WHERE OrgUnitCostCentre ='" & Value & "' AND ClientID = " & _ClientID
        End Select

        Dataset = _Database.Execute(QueryString, FleetManagerDatabaseType.Data, 300)
        If Dataset.Tables(0).Rows.Count > 0 Then
            ID = Dataset.Tables(0).Rows(0).Item(0)
            _ObjectIsValid = True
            'trace.writeline("...Found the OU")
        Else
            _ObjectIsValid = False
            'trace.writeline("...No OU Found")
        End If

        Dataset = Nothing

        Return ID

    End Function

