#Region " Public Methods "

    ''' <summary>
    ''' Load the Login details
    ''' </summary>
    ''' <remarks></remarks>
    Public Function Load(ByRef User As Login, Optional ByVal Behaviour As DefaultBehaviour = DefaultBehaviour.LoadOnly) As Boolean
        Dim SQL_ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        SQL_ID = _Connection.GetID(Me)

        Try
            If _Connection.ObjectIsValid Then

                User = _Connection.GetLoginbyID(SQL_ID) ' User = _Connection.GetLoginbyUID(SQL_ID)

                ' Set all the local variables
                _ChangeID = User.ChangeID
                _ClientID = User.ClientID
                _EmailAddress = User.EmailAddress
                _EndDate = User.EndDate
                _FacsimileNumber = User.FacsimileNumber
                _FirstLogin = User.FirstLogin
                _GUID =REDACTED
                _HideAllocated = User.HideAllocated
                _Home = User.Home
                _LastLogin = User.LastLogin
                _LoginID = User.LoginID
                _LoginName = User.LoginName
                _MarkupDisplay = User.MarkupDisplay
                _MarkupSecurity = User.MarkupSecurity
                _MobileNumber = User.MobileNumber
                _OrgUnitID = User.OrgUnitID
                _Password =REDACTED
                _PasswordExpiryDate = User.PasswordExpiryDate
                _PhoneNumber = User.PhoneNumber
                _RPP = User.RPP
                _SiteID = User.SiteID
                _StartDate = User.StartDate
                _Status = User.Status
                _UID =REDACTED
                _UserActive = User.UserActive
                _UserID =REDACTED
                _UserRoleID = User.UserRoleID
                _Valid = User.Valid
                _IsDirty = False
                _HasLoaded = True
                Return True
            Else
                ' Transfer the details we have to the new object
                User.ChangeID = _ChangeID
                User.ClientID = _ClientID
                User.EmailAddress = _EmailAddress
                User.EndDate = _EndDate
                User.FacsimileNumber = _FacsimileNumber
                User.FirstLogin = _FirstLogin
                User.GUID =REDACTED
                User.HideAllocated = _HideAllocated
                User.Home = _Home
                User.LastLogin = _LastLogin
                User.LoginID = _LoginID
                User.LoginName = _LoginName
                User.MarkupDisplay = _MarkupDisplay
                User.MarkupSecurity = _MarkupSecurity
                User.MobileNumber = _MobileNumber
                User.OrgUnitID = _OrgUnitID
                User.Password =REDACTED
                User.PasswordExpiryDate = _PasswordExpiryDate
                User.PhoneNumber = _PhoneNumber
                User.RPP = _RPP
                User.SiteID = _SiteID
                User.StartDate = _StartDate
                User.Status = _Status
                User.UID =REDACTED
                User.UserActive = _UserActive
                User.UserID =REDACTED
                User.UserRoleID = _UserRoleID
                User.Valid = _Valid

                Select Case Behaviour
                    Case DefaultBehaviour.FailOnNotExist
                        ' We are configured to raise an error if the OU could not be found.
                        Err.Raise(vbObjectError + 529, GetExecutingAssembly.GetName.Name, "The Login referenced by this UID does not exist.")
                        _IsDirty = False
                        _HasLoaded = False
                        Return False
                    Case DefaultBehaviour.LoadOrCreate
                        ' We are configured to create the OU if it could not be found
                        If User.ClientID > 0 Then
                            ' Now save it
                            User.UID =REDACTED
                        End If
                        _IsDirty = False
                        _HasLoaded = True
                        Return True
                    Case DefaultBehaviour.LoadOnly
                        _IsDirty = False
                        _HasLoaded = True
                        Return False
                End Select
            End If
        Catch
            _HasLoaded = False
            Return False
        End Try

    End Function

    ''' <summary>
    ''' Load the Login details
    ''' </summary>
    ''' <remarks></remarks>
    ''' 
    Public Function Load(Optional ByVal Behaviour As DefaultBehaviour = DefaultBehaviour.LoadOnly) As Boolean
        Dim SQL_ID As Int32 = 0
        Dim User As New Login

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        SQL_ID = _Connection.GetID(Me)

        Try
            If _Connection.ObjectIsValid Then

                User = _Connection.GetLoginbyID(SQL_ID)

                ' Set all the local variables
                _ChangeID = User.ChangeID
                _ClientID = User.ClientID
                _EmailAddress = User.EmailAddress
                _EndDate = User.EndDate
                _FacsimileNumber = User.FacsimileNumber
                _FirstLogin = User.FirstLogin
                _GUID =REDACTED
                _HideAllocated = User.HideAllocated
                _Home = User.Home
                _LastLogin = User.LastLogin
                _LoginID = User.LoginID
                _LoginName = User.LoginName
                _MarkupDisplay = User.MarkupDisplay
