    Public Function Save() As Int32
        Dim SQL_ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        ' Find the person
        SQL_ID = _Connection.GetID(Me)

        If Not _Connection.ObjectIsValid Then
            _LoginID = _Connection.Insert(Me)
            'trace.writeline("The ID for this Person is " & _LoginID)

            Return _LoginID
        Else
            If _IsDirty Then
                'trace.writeline("This Person has to be saved")
                _Connection.Update(Me)
            Else
                'trace.writeline("No requirement to save this Person")
            End If

            _IsDirty = False
            _LoginID = SQL_ID
            Return _LoginID 'Me.ID
        End If

    End Function

