#Region " Constructors"

    Public Sub New()

    End Sub

    Public Sub New(ByVal ClientID As Int32)
        If ClientID > 0 Then
            ' TODO:  Search for this clientID.
            _ClientID = ClientID
        Else
            Err.Raise(vbObjectError + 516, GetExecutingAssembly.GetName.Name, "Client ID not specified for FleetManager Connection.")
        End If
    End Sub

    Public Sub New(ByVal Connection As FMConnection)
        _Connection = Connection
    End Sub

    Public Sub New(ByVal ClientID As Int32, ByVal Connection As FMConnection)
        _ClientID = ClientID
        _Connection = Connection
    End Sub

