                OU.ParentOrganisationalUnitGUID =REDACTED
                OU.ParentOrganisationalUnitID = ParentOrganisationalUnitID
                OU.RebillingPlanID = _RebillingPlanID
                OU.Silent = _Silent
                OU.StartDate = _StartDate
                OU.UID =REDACTED

                OU.StreetAddress = _StreetAddress
                OU.Suburb = _Suburb
                OU.State = _State
                OU.Country = _Country
                OU.PostCode = _PostCode

                Select Case Behaviour
                    Case DefaultBehaviour.FailOnNotExist
                        ' We are configured to raise an error if the OU could not be found.
                        Err.Raise(vbObjectError + 513, GetExecutingAssembly.GetName.Name, "The Organisational Unit referenced by this UID does not exist.")
                        _IsDirty = False
                        _HasLoaded = False
                        Return False
                    Case DefaultBehaviour.LoadOrCreate
                        ' We are configured to create the OU if it could not be found
                        If OU.ClientID > 0 Then
                            ' Now save it
                            OU.ID = OU.Save(LoadResult)
                            _HasLoaded = True
                        Else
                            _HasLoaded = False
                        End If
                        _IsDirty = False

                        Return True
                    Case DefaultBehaviour.LoadOnly
                        _IsDirty = False
                        If SQL_ID > 0 Then _HasLoaded = True
                        Return False
                End Select
            End If
        Catch
            _HasLoaded = False
            Return False
        End Try

    End Function

