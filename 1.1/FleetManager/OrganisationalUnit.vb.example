#Region " Constructors"

    Public Sub New()

    End Sub

    Public Sub New(ByVal ClientID As Int32)
        If ClientID > 0 Then
            ' TODO:  Search for this clientID.
            _ClientID = ClientID
        Else
            Err.Raise(vbObjectError + 515, GetExecutingAssembly.GetName.Name, "Client ID not specified for FleetManager Connection.")
        End If
    End Sub

    Public Sub New(ByVal Connection As FMConnection)
        _Connection = Connection
    End Sub

    Public Sub New(ByVal ClientID As Int32, ByVal Connection As FMConnection)
        _ClientID = ClientID
        _Connection = Connection
    End Sub

#End Region

#Region " Public Methods "

    ''' <summary>
    ''' Save the OU details
    ''' </summary>
    ''' <remarks></remarks>
    Public Function Save(ByRef SaveOperation As FMDatabase.OperationResult) As Int32
        Dim SQL_ID As Int32 = 0
        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        SQL_ID = _Connection.GetID(Me)

        If Not _Connection.ObjectIsValid Then
            _ID = _Connection.Insert(Me)
            'trace.writeline("The ID for this OU is " & _ID)
            SaveOperation = FMDatabase.OperationResult.Insert
            Return _ID
        Else
            If _IsDirty Then
                Trace.WriteLine("This OU has to be saved")
                _Connection.Update(Me)
                SaveOperation = FMDatabase.OperationResult.Update
            Else
                'trace.writeline("No requirement to save this OU")
                SaveOperation = FMDatabase.OperationResult.None
            End If

            _IsDirty = False
            _ID = SQL_ID
            Return _ID 'Me.ID
        End If

    End Function

    ''' <summary>
    ''' Load the OU details
    ''' </summary>
    ''' <remarks></remarks>
    Public Function Load(ByRef OU As OrganisationalUnit, Optional ByVal Behaviour As DefaultBehaviour = DefaultBehaviour.LoadOnly) As Boolean
        Dim SQL_ID As Int32 = 0
        Dim LoadResult As FMDatabase.OperationResult

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        SQL_ID = _Connection.GetID(Me)

        Try
            If _Connection.ObjectIsValid Then
                'trace.writeline("Loading an OU's details...")

                OU = _Connection.GetOrganisationalUnitbyID(SQL_ID)

                ' Set all the properties - NOTE, NOT local variables
                Me.Budget = OU.Budget
                Me.ChangeID = OU.ChangeID
                Me.ClientID = OU.ClientID
                Me.CostCode = OU.CostCode
                Me.Custom1 = OU.Custom1
                Me.Custom2 = OU.Custom2
                Me.Custom3 = OU.Custom3
                Me.Custom4 = OU.Custom4
                Me.Custom5 = OU.Custom5
                Me.Custom6 = OU.Custom6
                Me.Custom7 = OU.Custom7
                Me.Custom8 = OU.Custom8
                Me.Custom9 = OU.Custom9
                Me.Custom10 = OU.Custom10
                Me.Custom11 = OU.Custom11
                Me.Custom12 = OU.Custom12
                Me.Custom13 = OU.Custom13
                Me.Custom14 = OU.Custom14
                Me.Custom15 = OU.Custom15
                Me.Custom16 = OU.Custom16
                Me.Custom17 = OU.Custom17
                Me.Custom18 = OU.Custom18
                Me.Custom19 = OU.Custom19
                Me.Custom20 = OU.Custom20
                Me.DefaultPersonBudget = OU.DefaultPersonBudget
                Me.EndDate = OU.EndDate
                Me.GUID =REDACTED
                Me.ID = OU.ID
                Me.Name = OU.Name
                Me.ParentOrganisationalUnitGUID =REDACTED
                Me.ParentOrganisationalUnitID = OU.ParentOrganisationalUnitID
                Me.RebillingPlanID = OU.RebillingPlanID
                Me.Silent = OU.Silent
                Me.StartDate = OU.StartDate
                Me.UID =REDACTED

                Me.StreetAddress = OU.StreetAddress
                Me.Suburb = OU.Suburb
                Me.State = OU.State
                Me.Country = OU.Country
                Me.PostCode = OU.PostCode

                _IsDirty = False
                _HasLoaded = True
                Return True
            Else
                ' Transfer the details we have to the new object
                OU.Budget = _Budget
                OU.ChangeID = _ChangeID
                OU.ClientID = _ClientID
                OU.Connection = _Connection
                OU.CostCode = _CostCode
                OU.Custom1 = _Custom1
                OU.Custom2 = _Custom2
                OU.Custom3 = _Custom3
                OU.Custom4 = _Custom4
                OU.Custom5 = _Custom5
                OU.Custom6 = _Custom6
                OU.Custom7 = _Custom7
                OU.Custom8 = _Custom8
                OU.Custom9 = _Custom9
                OU.Custom10 = _Custom10
                OU.Custom11 = _Custom11
                OU.Custom12 = _Custom12
                OU.Custom13 = _Custom13
                OU.Custom14 = _Custom14
                OU.Custom15 = _Custom15
                OU.Custom16 = _Custom16
                OU.Custom17 = _Custom17
                OU.Custom18 = _Custom18
                OU.Custom19 = _Custom19
                OU.Custom20 = _Custom20
                OU.DefaultPersonBudget = _DefaultPersonBudget
                OU.EndDate = _EndDate
                OU.GUID =REDACTED
                OU.ID = _ID
                OU.Name = _Name
                OU.ParentOrganisationalUnitGUID =REDACTED
                OU.ParentOrganisationalUnitID = ParentOrganisationalUnitID
                OU.RebillingPlanID = _RebillingPlanID
                OU.Silent = _Silent
                OU.StartDate = _StartDate
                OU.UID =REDACTED

                OU.StreetAddress = _StreetAddress
                OU.Suburb = _Suburb
                OU.State = _State
                OU.Country = _Country
                OU.PostCode = _PostCode

                Select Case Behaviour
                    Case DefaultBehaviour.FailOnNotExist
                        ' We are configured to raise an error if the OU could not be found.
                        Err.Raise(vbObjectError + 513, GetExecutingAssembly.GetName.Name, "The Organisational Unit referenced by this UID does not exist.")
                        _IsDirty = False
                        _HasLoaded = False
                        Return False
                    Case DefaultBehaviour.LoadOrCreate
                        ' We are configured to create the OU if it could not be found
                        If OU.ClientID > 0 Then
                            ' Now save it
                            OU.ID = OU.Save(LoadResult)
                            _HasLoaded = True
                        Else
                            _HasLoaded = False
                        End If
                        _IsDirty = False

                        Return True
                    Case DefaultBehaviour.LoadOnly
                        _IsDirty = False
                        If SQL_ID > 0 Then _HasLoaded = True
                        Return False
                End Select
            End If
        Catch
            _HasLoaded = False
            Return False
        End Try

    End Function

    ''' <summary>
    ''' Load the OU details
    ''' </summary>
    ''' <remarks></remarks>
    Public Function Load(Optional ByVal Behaviour As DefaultBehaviour = DefaultBehaviour.LoadOnly) As Boolean
        Dim SQL_ID As Int32 = 0
        Dim OU As New OrganisationalUnit
        Dim LoadResult As FMDatabase.OperationResult

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        SQL_ID = _Connection.GetID(Me)

        Try
            If _Connection.ObjectIsValid Then
