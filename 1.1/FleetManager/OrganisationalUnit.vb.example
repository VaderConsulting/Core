    ''' <summary>
    ''' Create an exact copy of the Org Unit
    ''' </summary>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function Clone() As OrganisationalUnit
        Dim OU_Copy As New OrganisationalUnit

        OU_Copy.Budget = _Budget
        OU_Copy.ChangeID = _ChangeID
        OU_Copy.ClientID = _ClientID
        OU_Copy.Connection = _Connection
        OU_Copy.CostCode = _CostCode
        OU_Copy.Custom1 = _Custom1
        OU_Copy.Custom2 = _Custom2
        OU_Copy.Custom3 = _Custom3
        OU_Copy.Custom4 = _Custom4
        OU_Copy.Custom5 = _Custom5
        OU_Copy.Custom6 = _Custom6
        OU_Copy.Custom7 = _Custom7
        OU_Copy.Custom8 = _Custom8
        OU_Copy.Custom9 = _Custom9
        OU_Copy.Custom10 = _Custom10
        OU_Copy.Custom11 = _Custom11
        OU_Copy.Custom12 = _Custom12
        OU_Copy.Custom13 = _Custom13
        OU_Copy.Custom14 = _Custom14
        OU_Copy.Custom15 = _Custom15
        OU_Copy.Custom16 = _Custom16
        OU_Copy.Custom17 = _Custom17
        OU_Copy.Custom18 = _Custom18
        OU_Copy.Custom19 = _Custom19
        OU_Copy.Custom20 = _Custom20
        OU_Copy.DefaultPersonBudget = _DefaultPersonBudget
        OU_Copy.EndDate = _EndDate
        OU_Copy.GUID =REDACTED
        'OU_Copy.HasLoaded = _HasLoaded
        OU_Copy.ID = _ID
        OU_Copy.IsDirty = _IsDirty
        OU_Copy.Name = _Name
        OU_Copy.LDAPPath = _LDAPPath
        OU_Copy.ParentOrganisationalUnitGUID =REDACTED
        OU_Copy.ParentOrganisationalUnitID = _ParentOrganisationalUnitID
        OU_Copy.RebillingPlanID = _RebillingPlanID
        OU_Copy.Silent = _Silent
        OU_Copy.StartDate = _StartDate
        OU_Copy.UID =REDACTED

        OU_Copy.StreetAddress = _StreetAddress
        OU_Copy.Suburb = _Suburb
        OU_Copy.State = _State
        OU_Copy.Country = _Country
        OU_Copy.PostCode = _PostCode

        Return OU_Copy

    End Function

