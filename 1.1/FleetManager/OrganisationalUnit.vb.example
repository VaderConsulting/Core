                _ParentOrganisationalUnitID = OU.ParentOrganisationalUnitID
                _RebillingPlanID = OU.RebillingPlanID
                _Silent = OU.Silent
                _StartDate = OU.StartDate
                _UID =REDACTED

                _StreetAddress = OU.StreetAddress
                _Suburb = OU.Suburb
                _State = OU.State
                _Country = OU.Country
                _PostCode = OU.PostCode

                'trace.writeline("As we have just loaded this, set IsDirty = False")
                _IsDirty = False
                _HasLoaded = True
                Return True
            Else
                ' Transfer the details we have to the new object
                OU.Budget = _Budget
                OU.ChangeID = _ChangeID
                OU.ClientID = _ClientID
                OU.Connection = _Connection
                OU.CostCode = _CostCode
                OU.Custom1 = _Custom1
