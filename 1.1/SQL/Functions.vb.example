    ''' <summary>
    ''' Execute a query, returning a dataset
    ''' </summary>
    ''' <param name="QueryString">The query to execute</param>
    ''' <param name="ConnectionString">The Connection string to connect with</param>
    ''' <param name="Timeout">OPTIONAL Timeout.  Only override the default if you have no other option</param>
    ''' <returns>Dataset</returns>
    ''' <remarks></remarks>

    Public Shared Function Execute(ByVal QueryString As String, ByVal ConnectionString As String, Optional ByVal Timeout As Int32 = 30) As DataSet
        Dim Data As New DataSet("DataSet1")
        Dim Table As New DataTable("Table1")
        Dim DataConnection As SqlConnection = Nothing
        Dim DataCommand As SqlCommand = Nothing
        Dim Adapter As SqlDataAdapter = New SqlDataAdapter

        Try

            DataConnection = New SqlConnection(ConnectionString)

            If DataConnection.State = ConnectionState.Closed Then
                Try
                    DataConnection.Open()
                Catch ex As Exception
                    Trace.WriteLine(ex.ToString)
                    Err.Raise(vbObjectError + 526, GetExecutingAssembly.GetName.Name, "The Database could not be opened." & vbCrLf & vbCrLf & "The actual error returned was:" & vbCrLf & ex.ToString)
                End Try
            End If

            DataCommand = New SqlCommand(QueryString, DataConnection)

            DataCommand.CommandType = CommandType.Text
            DataCommand.CommandTimeout = Timeout
            DataCommand.CommandText = QueryString

            Adapter.SelectCommand = DataCommand

            ' Get the data and put it into a table
            Adapter.Fill(Data)

            DataCommand.Dispose()
            Adapter.Dispose()
            DataConnection.Close()

            DataCommand = Nothing
            Adapter = Nothing
            DataConnection = Nothing

        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

        Return Data

    End Function

    ''' <summary>
    ''' Execute a query, without returning a dataset
    ''' </summary>
    ''' <param name="QueryString">The query to execute</param>
    ''' <param name="ConnectionString">The Connection string to connect with</param>
    ''' <param name="Timeout">OPTIONAL Timeout.  Only override the default if you have no other option</param>
    ''' <remarks></remarks>
    Public Shared Sub ExecuteNonQuery(ByVal QueryString As String, ByVal ConnectionString As String, Optional ByVal Timeout As Int32 = 30)
        Dim DataConnection As SqlConnection = Nothing
        Dim DataCommand As New SqlCommand

        Try
            DataConnection = New SqlConnection(ConnectionString)

            If DataConnection.State = ConnectionState.Closed Then DataConnection.Open()

            DataCommand = New SqlCommand(QueryString, DataConnection)

            DataCommand.CommandTimeout = Timeout
            DataCommand.CommandText = QueryString
            DataCommand.ExecuteNonQuery()

            DataCommand.Dispose()
            DataConnection.Close()

            DataCommand = Nothing
            DataConnection = Nothing

        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

    End Sub

    ''' <summary>
    ''' Execute a Store Procedure
    ''' </summary>
    ''' <param name="DataCommand"></param>
    ''' <param name="ConnectionString">The Connection string to connect with</param>
    ''' <param name="Timeout">OPTIONAL Timeout.  Only override the default if you have no other option</param>
    ''' <remarks></remarks>
    Public Shared Sub ExecuteStoredProcedure(ByRef DataCommand As SqlCommand, ByVal ConnectionString As String, Optional ByVal Timeout As Int32 = 30)
        Dim DataConnection As SqlConnection = Nothing

        Try
            DataConnection = New SqlConnection(ConnectionString)

            If DataConnection.State = ConnectionState.Closed Then DataConnection.Open()

            DataCommand.Connection = DataConnection
            DataCommand.CommandTimeout = Timeout

            DataCommand.ExecuteScalar()

            DataConnection.Close()

        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

        DataConnection = Nothing

    End Sub

    Public Shared Function TranslatedConnectionString(ByVal OriginalConnectionString As String) As String
        Dim OutputConnectionString As String = OriginalConnectionString
        Dim IpAddress As String = ""

        Try
            IpAddress = System.Net.Dns.GetHostByName(My.Computer.Name).AddressList(0).ToString

            If Not CStr(My.Computer.Info.OSFullName) Like "*Server*" Or System.Diagnostics.Debugger.IsAttached Then
                ' SQL instances
                OutputConnectionString = OutputConnectionString.Replace("10.1.14.16", "203.161.116.150") ' Zeus
                OutputConnectionString = OutputConnectionString.Replace("10.1.14.9", "203.161.67.98")    ' Apollo
                ' Others (PROBABLY NEVER USED AS THEY ARE WEB SERVERS)
                OutputConnectionString = OutputConnectionString.Replace("10.1.14.10", "203.161.116.144") ' Argos
                OutputConnectionString = OutputConnectionString.Replace("10.1.14.11", "203.161.116.145") ' ??
                OutputConnectionString = OutputConnectionString.Replace("10.1.14.12", "203.161.116.146") ' Hermes
                OutputConnectionString = OutputConnectionString.Replace("10.1.14.13", "203.161.116.147") ' ??
                OutputConnectionString = OutputConnectionString.Replace("10.1.14.14", "203.161.116.148") ' Hades
                OutputConnectionString = OutputConnectionString.Replace("10.1.14.15", "203.161.116.149") ' ??
            End If

        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

        Console.WriteLine("Translated Connection string: " & OutputConnectionString)

        Return OutputConnectionString

    End Function

    Public Shared Function GetDataRowFromDataset(ByVal Recordset As DataSet, ByVal TableName As String, ByVal RowNumber As Integer) As DataRow
        Dim Row As DataRow = Nothing

        Try
            If Recordset.Tables.Count >= 0 Then
                If Recordset.Tables(TableName).Rows.Count >= RowNumber Then
                    Row = Recordset.Tables(TableName).Rows(RowNumber)
                End If
            End If
        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

        Return Row
    End Function

    Public Shared Function GetDataRowFromDataset(ByVal Recordset As DataSet, ByVal TableNumber As Integer, ByVal RowNumber As Integer) As DataRow
        Dim Row As DataRow = Nothing

        Try
            If Recordset.Tables.Count >= TableNumber Then
                If Recordset.Tables(TableNumber).Rows.Count >= RowNumber Then
                    Row = Recordset.Tables(TableNumber).Rows(RowNumber)
                End If
            End If
        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

        Return Row

    End Function

    Public Shared Function GetFieldFromDataRow(ByVal Row As DataRow, ByVal FieldNumber As Integer) As Object
        Dim ReturnValue As Object = Nothing

        Try
            ReturnValue = Row.Item(FieldNumber)
        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

        Return ReturnValue

    End Function

    Public Shared Function GetFieldFromDataRow(ByVal Row As DataRow, ByVal FieldName As String) As Object
        Dim ReturnValue As Object = Nothing

        Try
            ReturnValue = Row.Item(FieldName).ToString
        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

        Return ReturnValue

    End Function

    Public Shared Function StringValueFromDataset(ByVal FieldName As String, ByVal QueryString As String, ByVal ConnectionString As String) As String
        Dim Result As String = ""

        Try
            Result = GetFieldFromDataRow(GetDataRowFromDataset(Execute(QueryString, ConnectionString), 0, 0), FieldName).ToString
        Catch ex As Exception
            ' Don't catch it, just return it back
            Throw ex
        End Try

        Return Result

    End Function

End Class
