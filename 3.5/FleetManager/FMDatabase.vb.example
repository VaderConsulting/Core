    Public Sub New(ByVal ControlDatabaseConnectionString As String, ByVal SiteID As Int32)
        _ControlConnectionString = ControlDatabaseConnectionString
        _DataConnectionString = GetDatabaseConnectionString2(ControlDatabaseConnectionString, SiteID)
        _SiteID = SiteID
    End Sub

