    Public Sub Initialize(ByVal ControlDatabaseConnectionString As String, ByVal SiteID As Int32)
        _ControlConnectionString = ControlDatabaseConnectionString
        _DataConnectionString = GetDatabaseConnectionString2(ControlDatabaseConnectionString, SiteID)
        _SiteID = SiteID
    End Sub

    Private Function TranslateServerName(ByVal ConnectionString As String) As String
        Dim NewConnectionString As String = ""
        Dim PreviousValues() As String = ConnectionString.Split(";")
        Dim ServerName As String = ""

        ServerName = PreviousValues(0).ToLower.Replace("server=", "")

        ServerName = ServerName.Replace("10.1.14.9", "APOLLO")
        ServerName = ServerName.Replace("10.1.14.1", "APOLLO")
        NewConnectionString = "REDACTED" & ServerName

        For iCounter As Integer = 1 To PreviousValues.Length - 1
            If NewConnectionString.Length > 0 Then
                NewConnectionString &= ";"
            End If

            NewConnectionString &= PreviousValues(iCounter)
        Next

        Return NewConnectionString
    End Function

    ''' <summary>
    ''' Retrieve the database connection string
    ''' </summary>
    ''' <param name="ControlDatabaseConnectionString"></param>
    ''' <param name="SiteID"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetDatabaseConnectionString(ByVal ControlDatabaseConnectionString As String, ByVal SiteID As Int32) As String
        Dim DataConnectionString As String = ""
        Dim QueryString As String = "SELECT DatabaseDetails.ConnectionString FROM SiteDetails INNER JOIN DatabaseDetails ON SiteDetails.DatabaseID = DatabaseDetails.UID where SiteDetails.SiteID = " & CStr(SiteID)
        Dim ReturnData As New DataSet("DataSet1")
        Dim Table As New DataTable("Table1")
        Dim DataConnection As New SqlConnection(ControlDatabaseConnectionString)
        Dim DataReader As SqlDataReader
        Dim DataCommand As New SqlCommand

        _SiteID = SiteID

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        If DataConnection.State = ConnectionState.Closed Then DataConnection.Open()

        DataCommand = New SqlCommand(QueryString, DataConnection)

        'trace.writeline(Space(Trace.FrameCount * 2) & "  |-> SQL: " & QueryString)
        DataCommand.CommandText = QueryString
        DataReader = DataCommand.ExecuteReader()
        ' Get the data and put it into a table
        If DataReader.HasRows Then
            Table.Load(DataReader)
        End If

        ReturnData.Tables.Add(Table)

        If ReturnData.Tables(0).Rows.Count > 0 Then
            'DataConnectionString = GetTranslatedConnectionString(ReturnData.Tables(0).Rows(0).Item(0))
            DataConnectionString = ReturnData.Tables(0).Rows(0).Item(0)

            'AA for Testing 
            'DataConnectionString = TranslateServerName(DataConnectionString)
        End If

        DataCommand.Dispose()
        DataReader.Close()
        DataConnection.Close()

        DataCommand = Nothing
        DataReader = Nothing
        DataConnection = Nothing

        Return TranslatedConnectionString(DataConnectionString)
    End Function

    ''' <summary>
    ''' Retrieve the database connection string, whilst also populating the other properties
    ''' </summary>
    ''' <param name="ControlDatabaseConnectionString"></param>
    ''' <param name="SiteID"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetDatabaseConnectionString2(ByVal ControlDatabaseConnectionString As String, ByVal SiteID As Int32) As String
        Dim DataConnectionString As String = ""
        Dim QueryString As String = ""
        Dim ReturnData As New DataSet("DataSet1")
        Dim Table As New DataTable("Table1")
        Dim DataConnection As New SqlConnection(ControlDatabaseConnectionString)
        Dim DataReader As SqlDataReader
        Dim DataCommand As New SqlCommand

        QueryString &= "SELECT     DatabaseDetails.ConnectionString, "
        QueryString &= "           SiteDetails.HostName, "
        QueryString &= "           SiteDetails.SiteLogo, "
        QueryString &= "           SiteDetails.WelcomeText, "
        QueryString &= "           SiteDetails.StyleSheet, "
        QueryString &= "           SiteDetails.HelpdeskEmail, "
        QueryString &= "           SiteDetails.HelpPhone, "
        QueryString &= "           SiteDetails.ProductName, "
        QueryString &= "           SiteDetails.SiteLogoRight, "
        QueryString &= "           SiteDetails.SiteLogoLeft "
        QueryString &= "FROM       SiteDetails INNER JOIN "
        QueryString &= "           DatabaseDetails ON SiteDetails.DatabaseID = DatabaseDetails.UID "
        QueryString &= "WHERE     (SiteDetails.SiteID = " & CStr(SiteID) & ")"

        _SiteID = SiteID

        If DataConnection.State = ConnectionState.Closed Then DataConnection.Open()

        DataCommand = New SqlCommand(QueryString, DataConnection)

        DataCommand.CommandText = QueryString
        DataReader = DataCommand.ExecuteReader()
        ' Get the data and put it into a table
        If DataReader.HasRows Then
            Table.Load(DataReader)
        End If

        ReturnData.Tables.Add(Table)

        If ReturnData.Tables(0).Rows.Count > 0 Then
            DataConnectionString = ReturnData.Tables(0).Rows(0).Item(0) & ""
            _HostName = ReturnData.Tables(0).Rows(0).Item(1) & ""
            _SiteLogo = ReturnData.Tables(0).Rows(0).Item(2) & ""
            _WelcomeText = ReturnData.Tables(0).Rows(0).Item(3) & ""
            _StyleSheet = ReturnData.Tables(0).Rows(0).Item(4) & ""
            _HelpdeskEmail = ReturnData.Tables(0).Rows(0).Item(5) & ""
            _HelpPhone = ReturnData.Tables(0).Rows(0).Item(6) & ""
            _ProductName = ReturnData.Tables(0).Rows(0).Item(7) & ""
            _SiteLogoRight = ReturnData.Tables(0).Rows(0).Item(8) & ""
            _SiteLogoLeft = ReturnData.Tables(0).Rows(0).Item(9) & ""
        End If

        DataCommand.Dispose()
        DataReader.Close()
        DataConnection.Close()

        DataCommand = Nothing
        DataReader = Nothing
        DataConnection = Nothing

        Return TranslatedConnectionString(DataConnectionString)
    End Function

    ''' <summary>
    ''' Execute a query, returning a dataset
    ''' </summary>
    ''' <param name="QueryString">The query to execute</param>
    ''' <param name="Target">The FMDatabase object</param>
    ''' <param name="Timeout">OPTIONAL Timeout.  Only override the default if you have no other option</param>
    ''' <returns>Dataset</returns>
    ''' <remarks></remarks>
    Public Function Execute(ByVal QueryString As String, ByVal Target As FleetManagerDatabaseType, Optional ByVal Timeout As Int32 = 30) As DataSet
        Dim ReturnData As New DataSet("DataSet1")
        Dim Table As New DataTable("Table1")
        Dim DataConnection As SqlConnection = Nothing

        Select Case Target
            Case FleetManagerDatabaseType.Control
                DataConnection = New SqlConnection(_ControlConnectionString)
            Case FleetManagerDatabaseType.Data
                DataConnection = New SqlConnection(_DataConnectionString)
        End Select

        ' Translate connection string to cater for running from different locations
        '_DataConnectionString = GetTranslatedConnectionString(_DataConnectionString)

        Dim DataReader As SqlDataReader
        Dim DataCommand As New SqlCommand

        DataCommand.CommandTimeout = Timeout

        If DataConnection.State = ConnectionState.Closed Then
            Try

                DataConnection.Open()
            Catch ex As Exception
                Trace.WriteLine(ex.ToString)
                Err.Raise(vbObjectError + 526, GetExecutingAssembly.GetName.Name, "The Database could not be opened." & vbCrLf & vbCrLf & "The actual error returned was:" & vbCrLf & ex.ToString)
            End Try
        End If

        DataCommand = New SqlCommand(QueryString, DataConnection)
        DataCommand.CommandText = QueryString
        DataReader = DataCommand.ExecuteReader()
        ' Get the data and put it into a table
        If DataReader.HasRows Then
            Table.Load(DataReader)
        End If

        ReturnData.Tables.Add(Table)

        DataCommand.Dispose()

        DataReader.Close()
        DataConnection.Close()

        DataCommand = Nothing
        DataReader = Nothing
        DataConnection = Nothing

        Application.DoEvents()

        Return ReturnData
    End Function


    Public Function ExecuteScalar(ByVal QueryString As String, ByVal Target As FleetManagerDatabaseType, Optional ByVal Timeout As Int32 = 30)
        Dim DataConnection As SqlConnection = Nothing
        Dim UID As Integer = 0

        Select Case Target
            Case FleetManagerDatabaseType.Control
                DataConnection = New SqlConnection(_ControlConnectionString)
            Case FleetManagerDatabaseType.Data
                DataConnection = New SqlConnection(_DataConnectionString)
        End Select

        ' Translate connection string to cater for running from different locations
        '_DataConnectionString = GetTranslatedConnectionString(_DataConnectionString)

        Dim DataCommand As New SqlCommand
        DataCommand.CommandTimeout = Timeout

        If DataConnection.State = ConnectionState.Closed Then DataConnection.Open()

        DataCommand = New SqlCommand(QueryString, DataConnection)

        DataCommand.CommandText = QueryString
        UID =REDACTED

        DataCommand.Dispose()
        DataConnection.Close()

        DataCommand = Nothing
        DataConnection = Nothing

        Application.DoEvents()

        Return UID
    End Function

    ''' <summary>
    ''' Execute a query, without returning a dataset
    ''' </summary>
    ''' <param name="QueryString">The query to execute</param>
    ''' <param name="Target">The FMDatabase object</param>
    ''' <param name="Timeout">OPTIONAL Timeout.  Only override the default if you have no other option</param>
    ''' <remarks></remarks>
    Public Sub ExecuteNonQuery(ByVal QueryString As String, ByVal Target As FleetManagerDatabaseType, Optional ByVal Timeout As Int32 = 30)
        Dim DataConnection As SqlConnection = Nothing

        Select Case Target
            Case FleetManagerDatabaseType.Control
                DataConnection = New SqlConnection(_ControlConnectionString)
            Case FleetManagerDatabaseType.Data
                DataConnection = New SqlConnection(_DataConnectionString)
        End Select

        ' Translate connection string to cater for running from different locations
        '_DataConnectionString = GetTranslatedConnectionString(_DataConnectionString)

        Dim DataCommand As New SqlCommand
        DataCommand.CommandTimeout = Timeout

        If DataConnection.State = ConnectionState.Closed Then DataConnection.Open()

        DataCommand = New SqlCommand(QueryString, DataConnection)

        DataCommand.CommandText = QueryString
        DataCommand.ExecuteNonQuery()

        DataCommand.Dispose()
        DataConnection.Close()

        DataCommand = Nothing
        DataConnection = Nothing

        Application.DoEvents()

    End Sub

    ''' <summary>
    ''' Execute a Store Procedure
    ''' </summary>
    ''' <param name="DataCommand"></param>
    ''' <param name="Target">The FMDatabase object</param>
    ''' <param name="Timeout">OPTIONAL Timeout.  Only override the default if you have no other option</param>
    ''' <remarks></remarks>
    Public Sub ExecuteStoredProcedure(ByRef DataCommand As SqlCommand, ByVal Target As FleetManagerDatabaseType, Optional ByVal Timeout As Int32 = 30)
        Dim DataConnection As SqlConnection = Nothing

        Select Case Target
            Case FleetManagerDatabaseType.Control
                DataConnection = New SqlConnection(_ControlConnectionString)
            Case FleetManagerDatabaseType.Data
                DataConnection = New SqlConnection(_DataConnectionString)
        End Select

        ' Translate connection string to cater for running from different locations
        '_DataConnectionString = GetTranslatedConnectionString(_DataConnectionString)

        If DataConnection.State = ConnectionState.Closed Then DataConnection.Open()

        DataCommand.Connection = DataConnection
        DataCommand.CommandTimeout = Timeout

        DataCommand.ExecuteScalar()

        DataConnection.Close()

        DataConnection = Nothing

        Application.DoEvents()
    End Sub

    ''' <summary>
    ''' Override the data connection string retrieved by the GetDatabaseConnectionString() method
    ''' </summary>
    ''' <param name="NewConnectionString"></param>
    ''' <remarks>Should only be used temporarily, or for test purposes</remarks>
    Public Sub OverrideDataConnectionString(ByVal NewConnectionString As String)
        _DataConnectionString = NewConnectionString
    End Sub

    Public Shared Function TranslatedConnectionString(ByVal OriginalConnectionString As String) As String
        Dim OutputConnectionString As String = OriginalConnectionString
        Dim IpAddress As String = System.Net.Dns.GetHostAddresses(My.Computer.Name)(0).ToString

        If Not My.Computer.Info.OSFullName Like "*Server*" Or System.Diagnostics.Debugger.IsAttached Then
            ' SQL instances
            OutputConnectionString = OutputConnectionString.Replace("10.1.14.16", "203.161.116.150") ' Zeus
            OutputConnectionString = OutputConnectionString.Replace("10.1.14.9", "203.161.67.98")    ' Apollo
            ' Others (PROBABLY NEVER USED AS THEY ARE WEB SERVERS)
            OutputConnectionString = OutputConnectionString.Replace("10.1.14.10", "203.161.116.144") ' Argos
            OutputConnectionString = OutputConnectionString.Replace("10.1.14.11", "203.161.116.145") ' ??
            OutputConnectionString = OutputConnectionString.Replace("10.1.14.12", "203.161.116.146") ' Hermes
            OutputConnectionString = OutputConnectionString.Replace("10.1.14.13", "203.161.116.147") ' ??
            OutputConnectionString = OutputConnectionString.Replace("10.1.14.14", "203.161.116.148") ' Hades
            OutputConnectionString = OutputConnectionString.Replace("10.1.14.15", "203.161.116.149") ' ??

            'Debug.Print("Translated string: " & OutputConnectionString)

            'If _DataConnectionString = "REDACTED" Then
            '    _DataConnectionString = "REDACTED"
            'End If
        End If


        Console.WriteLine("Translated Connection string: " & OutputConnectionString)
        Return OutputConnectionString
    End Function

