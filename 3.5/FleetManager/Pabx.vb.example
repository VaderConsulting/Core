#Region " Imports "
Imports FleetManager.FMConnection
#End Region

Public Class Pabx

#Region " Private Variables "
    Private _ID As Integer = 0
    Private _Code As String = ""
    Private _Name As String = ""
    Private _Comment As String = ""
    Private _Connection As FMConnection
    Private _AllSites As Collections.SortedList
#End Region

#Region " Properties "
    Public Property ID As Integer
        Get
            Return _ID
        End Get
        Set(ByVal value As Integer)
            _ID = value
        End Set
    End Property

    Public Property Code As String
        Get
            Return _Code
        End Get
        Set(ByVal value As String)
            _Code = value
        End Set
    End Property

    Public Property Name As String
        Get
            Return _Name
        End Get
        Set(ByVal value As String)
            _Name = value
        End Set
    End Property

    Public Property Comment As String
        Get
            Return _Comment
        End Get
        Set(ByVal value As String)
            _Comment = value
        End Set
    End Property

    Public Property AllSites As Collections.SortedList
        Get
            Return _AllSites
        End Get
        Set(ByVal value As Collections.SortedList)
            _AllSites = value
        End Set
    End Property

#End Region

#Region " Structure "
    Structure PabxStructure
        Dim ID As Integer
        Dim Code As String
        Dim Name As String
        Dim Comment As String
    End Structure
#End Region

#Region " Methods "

    Public Sub New(ByVal Connection As FMConnection)
        _Connection = Connection
        Dim DataSet As New DataSet
        _AllSites = New Collections.SortedList

        DataSet = _Connection.GetAllSites()

        Dim ObjectPabx As PabxStructure
        For Each Row As DataRow In DataSet.Tables(0).Rows
            ObjectPabx = New PabxStructure
            ObjectPabx.Code = Row("PabxCode")
            ObjectPabx.Name = Row("PabxName")
            ObjectPabx.Comment = Row("Comment")
            ObjectPabx.ID = Row("PabxID")

            _AllSites.Add(_AllSites.Count + 1, ObjectPabx)
        Next

    End Sub

    Public Function AddPabx(ByVal PabxCode As String) As Integer
        Dim PabxName As String = ""
        Dim UID As Integer = 0

        If Not CodeExists(PabxCode, UID) Then
            _Code = PabxCode
            If PabxCode.ToLower.Trim = "pabx0" Then
                PabxName = "Blank Pabx"
            Else
                PabxName = "Pabx " & PabxCode
                GetPabxName(PabxName)
            End If
            _Name = PabxName
            _Comment = "Pabx added by the Call Data Importer"
            UID =REDACTED

            If UID > 0 Then
                Dim ObjectPabx As New PabxStructure
                ObjectPabx.Code = _Code
                ObjectPabx.Comment = _Comment
                ObjectPabx.ID = UID
                ObjectPabx.Name = _Name

                _AllSites.Add(_AllSites.Count + 1, ObjectPabx)
            End If

        End If

        Return UID
    End Function

   

    Private Sub GetPabxName(ByRef PabxName As String)

        For iCounter As Integer = 1 To _AllSites.Count
            If CType(_AllSites(iCounter), PabxStructure).Name.ToLower = PabxName.ToLower Then
                PabxName = "Pabx " & CInt(PabxName.Split(" ")(1)) + 1
                GetPabxName(PabxName)
            End If
        Next
    End Sub

#End Region

#Region " Functions "
    Private Function CodeExists(ByVal Code As String, ByRef UID As Integer) As Boolean
        For iCounter As Integer = 1 To _AllSites.Count
            If CType(_AllSites(iCounter), PabxStructure).Code = Code Then
                UID =REDACTED PabxStructure).ID
                Return True
            End If
        Next

        Return False
    End Function
#End Region

End Class
