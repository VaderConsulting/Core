    ''' <summary>
    ''' Initializes a new instance of the <see cref="Person" /> class.
    ''' </summary>
    ''' <param name="ClientID">The client ID.</param>
    Public Sub New(ByVal ClientID As Int32)
        If ClientID > 0 Then
            ' TODO:  Search for this clientID.
            _ClientID = ClientID
        Else
            Err.Raise(vbObjectError + 516, GetExecutingAssembly.GetName.Name, "Client ID not specified for FleetManager Connection.")
        End If
    End Sub

    ''' <summary>
    ''' Initializes a new instance of the <see cref="Person" /> class.
    ''' </summary>
    Public Sub New()

    End Sub

    ''' <summary>
    ''' Initializes a new instance of the <see cref="Person" /> class.
    ''' </summary>
    ''' <param name="Connection">The connection.</param>
    Public Sub New(ByVal Connection As FMConnection)
        '_ClientID = ClientID
        _Connection = Connection
    End Sub

    ''' <summary>
    ''' Initializes a new instance of the <see cref="Person" /> class.
    ''' </summary>
    ''' <param name="ClientID">The client ID.</param>
    ''' <param name="Connection">The connection.</param>
    Public Sub New(ByVal ClientID As Int32, ByVal Connection As FMConnection)
        _ClientID = ClientID
        _Connection = Connection
    End Sub

    ''' <summary>
    ''' Load the Person details
    ''' </summary>
    ''' <remarks></remarks>
    Public Function Load(ByRef User As Person, Optional ByVal Behaviour As DefaultBehaviour = DefaultBehaviour.LoadOnly) As Boolean
        Dim SQL_ID As Int32 = 0

        'Dim t As New StackTrace : Trace.WriteLine(Space(t.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & t.GetFrame(1).GetMethod().Name) : t = Nothing

        SQL_ID = _Connection.GetID(Me)

        Try
            If _Connection.ObjectIsValid Then

                User = _Connection.GetPersonbyID(SQL_ID)

                ' Set all the local variables
                _Budget = User.Budget
                _ChangeID = User.ChangeID
                _ClientID = User.ClientID
                _CostCode = User.CostCode
                _Custom1 = User.Custom1
                _Custom10 = User.Custom10
                _Custom11 = User.Custom11
                _Custom12 = User.Custom12
                _Custom13 = User.Custom13
                _Custom14 = User.Custom14
                _Custom2 = User.Custom2
                _Custom3 = User.Custom3
                _Custom4 = User.Custom4
                _Custom5 = User.Custom5
                _Custom6 = User.Custom6
                _Custom7 = User.Custom7
                _Custom8 = User.Custom8
                _Custom9 = User.Custom9
                _EmailAddress = User.EmailAddress
                _EndDate = User.EndDate
                _FirstName = User.FirstName
                _GUID =REDACTED
                _MiddleName = User.MiddleName
                _OrganisationalUnitID = User.OrganisationalUnitID
                _Salutation = User.Salutation
                _SecondaryContactNumber = User.SecondaryContactNumber
                _Silent = User.Silent
                _StartDate = User.StartDate
                _Status = User.Status
                _Surname = User.Surname
                _Title = User.Title
                _UID =REDACTED
                _Valid = User.Valid
                _IsDirty = False
                _HasLoaded = True
                Return True
            Else
                ' Transfer the details we have to the new object
                User.Budget = _Budget
                User.ChangeID = _ChangeID
                User.ClientID = _ClientID
                User.CostCode = _CostCode
                User.Custom1 = _Custom1
                User.Custom10 = _Custom10
                User.Custom11 = _Custom11
                User.Custom12 = _Custom12
                User.Custom13 = _Custom13
                User.Custom14 = _Custom14
                User.Custom2 = _Custom2
                User.Custom3 = _Custom3
                User.Custom4 = _Custom4
                User.Custom5 = _Custom5
                User.Custom6 = _Custom6
                User.Custom7 = _Custom7
                User.Custom8 = _Custom8
                User.Custom9 = _Custom9
                User.EmailAddress = _EmailAddress
                User.EndDate = _EndDate
                User.FirstName = _FirstName
                User.GUID =REDACTED
                User.MiddleName = MiddleName
                User.OrganisationalUnitID = _OrganisationalUnitID
                User.Salutation = _Salutation
                User.SecondaryContactNumber = _SecondaryContactNumber
                User.Silent = _Silent
                User.StartDate = _StartDate
                User.Status = _Status
                User.Surname = _Surname
                User.Title = _Title
