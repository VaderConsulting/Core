    ''' <summary>
    ''' Check if valid.  Simple check of surname and firstname.
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Property Valid() As Boolean
        Get
            _Valid = (_Surname.Trim.Length > 0 And _FirstName.Trim.Length > 0)
            Return _Valid
        End Get
        Set(ByVal value As Boolean)
            _Valid = value
        End Set
    End Property

