    ''' <summary>
    ''' Save the Person details
    ''' </summary>
    ''' <remarks></remarks>
    Public Function Save() As Int32
        Dim SQL_ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        ' Find the person
        SQL_ID = _Connection.GetID(Me)

        If Not _Connection.ObjectIsValid Then
            _ID = _Connection.Insert(Me)
            'trace.writeline("The ID for this Person is " & _ID)

            Return _ID
        Else
            If _IsDirty Then
                'trace.writeline("This Person has to be saved")
                _Connection.Update(Me)
            Else
                'trace.writeline("No requirement to save this Person")
            End If

            _IsDirty = False
            _ID = SQL_ID
            Return _ID 'Me.ID
        End If
    End Function

    ''' <summary>
    ''' Save the Person details
    ''' </summary>
    ''' <param name="SaveOperation">A ByRef OperationResult so that the caller knows what operation was performed (Update or Insert)</param>
    ''' <returns>The ID of the Person</returns>
    ''' <remarks></remarks>
    Public Function Save(ByRef SaveOperation As OperationResult) As Int32
        Dim SQL_ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        ' Find the person
        SQL_ID = _Connection.GetID(Me)

        If Not _Connection.ObjectIsValid Then
            _ID = _Connection.Insert(Me)
            'trace.writeline("The ID for this Person is " & _ID)
            SaveOperation = OperationResult.Insert
            Return _ID
        Else
            If _IsDirty Then
                'trace.writeline("This Person has to be saved")
                _Connection.Update(Me)
                SaveOperation = OperationResult.Update
            Else
                'trace.writeline("No requirement to save this Person")
                SaveOperation = OperationResult.None
            End If

            _IsDirty = False
            _ID = SQL_ID
            Return _ID 'Me.ID
        End If
    End Function

    Public Function Save(ByVal ParameterName As String, ByVal ParameterValue As String, ByVal ParameterIsString As Boolean) As Boolean
        Dim SQL_ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        SQL_ID = _Connection.GetID(FleetManagerObjectType.Person, ParameterName, ParameterValue, ParameterIsString)

        If Not _Connection.ObjectIsValid Then
            _ID = _Connection.Insert(Me)
            'trace.writeline("The ID for this Person is " & _ID)

            Return _ID
        Else
            If _IsDirty Then
                'trace.writeline("This Person has to be saved")
                _Connection.Update(Me, ParameterName, ParameterValue, ParameterIsString)
