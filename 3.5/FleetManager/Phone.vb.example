        _ClientID = ClientID
        _Connection = Connection
    End Sub

    ''' <summary>
    ''' Load the Phone details
    ''' </summary>
    ''' <remarks></remarks>
    Public Function Load(ByRef Service As Phone, Optional ByVal Behaviour As DefaultBehaviour = DefaultBehaviour.LoadOnly) As Boolean
        Dim SQL_ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        SQL_ID = _Connection.GetID(Me)

        Try
            If _Connection.ObjectIsValid Then

                Service = _Connection.GetPhonebyUID(SQL_ID)

                ' Set all the local variables
                '_CreateDate = Service.CreateDate
                _AccountNumber = Service.AccountNumber
                _Budget = Service.Budget
                _ChangeID = Service.ChangeID
                _ClientID = Service.ClientID
                _Comment = Service.Comment
                _CostCode = Service.CostCode
                _EndDate = Service.EndDate
                _Feature0 = Service.Feature0
                _Feature1 = Service.Feature1
                _Feature2 = Service.Feature2
                _Feature3 = Service.Feature3
                _Feature4 = Service.Feature4
                _Feature5 = Service.Feature5
                _Feature6 = Service.Feature6
                _Feature7 = Service.Feature7
                _Feature8 = Service.Feature8
                _Feature9 = Service.Feature9
                _GUID =REDACTED
                _ID = Service.ID
                _NetworkTypeID = Service.NetworkTypeID
                _Number = Service.Number
                _OrganisationalUnitID = Service.OrganisationalUnitID
                _PABXSiteID = Service.PABXSiteID
                _PABXSiteName = Service.PABXSiteName
                _PersonID = Service.PersonID
                _PlanID = Service.PlanID
                _PrimaryPhoneID = Service.PrimaryPhoneID
                _ProviderID = Service.ProviderID
                _RebillingPlanID = Service.RebillingPlanID
                _ServiceType = Service.ServiceType
                _Silent = Service.Silent
                _Spare1 = Service.Spare1
                _Spare2 = Service.Spare2
                _Spare3 = Service.Spare3
                _Spare4 = Service.Spare4
                _Spare5 = Service.Spare5
                _StartDate = Service.StartDate
                _Status = Service.Status
                _UID =REDACTED
                _IsDirty = False
                _HasLoaded = True
                Return True
            Else
                ' Transfer the details we have to the new object
                'Service.CreateDate = _CreateDate
                Service.AccountNumber = _AccountNumber
                Service.Budget = _Budget
                Service.ChangeID = _ChangeID
                Service.ClientID = _ClientID
                Service.Comment = _Comment
                Service.CostCode = _CostCode
                Service.EndDate = _EndDate
                Service.Feature0 = _Feature0
                Service.Feature1 = _Feature1
                Service.Feature2 = _Feature2
                Service.Feature3 = _Feature3
                Service.Feature4 = _Feature4
                Service.Feature5 = _Feature5
                Service.Feature6 = _Feature6
                Service.Feature7 = _Feature7
                Service.Feature8 = _Feature8
                Service.Feature9 = _Feature9
                Service.GUID =REDACTED
                Service.ID = _ID
                Service.NetworkTypeID = _NetworkTypeID
                Service.Number = _Number
                Service.OrganisationalUnitID = _OrganisationalUnitID
                Service.PABXSiteID = _PABXSiteID
                Service.PABXSiteName = _PABXSiteName
                Service.PersonID = _PersonID
                Service.PlanID = _PlanID
                Service.PrimaryPhoneID = _PrimaryPhoneID
                Service.ProviderID = _ProviderID
                Service.RebillingPlanID = _RebillingPlanID
                Service.ServiceType = _ServiceType
                Service.Silent = _Silent
                Service.Spare1 = _Spare1
                Service.Spare2 = _Spare2
                Service.Spare3 = _Spare3
                Service.Spare4 = _Spare4
                Service.Spare5 = _Spare5
                Service.StartDate = _StartDate
                Service.Status = _Status
                Service.UID =REDACTED

                Select Case Behaviour
                    Case DefaultBehaviour.FailOnNotExist
                        ' We are configured to raise an error if the Phone could not be found.
                        Err.Raise(vbObjectError + 520, GetExecutingAssembly.GetName.Name, "The Phone referenced by this UID does not exist.")
                        _IsDirty = False
                        _HasLoaded = False
                        Return False
                    Case DefaultBehaviour.LoadOrCreate
                        ' We are configured to create the Phone if it could not be found
                        If Service.ClientID > 0 Then
                            ' Now save it
                            Service.UID =REDACTED
                            _HasLoaded = True
                        Else
                            _HasLoaded = False
                        End If
                        _IsDirty = False

                        Return True
                    Case DefaultBehaviour.LoadOnly
                        _IsDirty = False
                        If SQL_ID > 0 Then _HasLoaded = True
                        Return False
                End Select
            End If
        Catch
            _HasLoaded = False
            Return False
        End Try
    End Function

