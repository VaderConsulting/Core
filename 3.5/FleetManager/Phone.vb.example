    ''' <summary>
    ''' Save the Phone details
    ''' </summary>
    ''' <returns>The ID of the Phone</returns>
    ''' <remarks></remarks>
    Public Function Save() As Int32
        Dim SQL_ID As Int32 = 0

        'Dim Trace As New StackTrace : trace.writeline(Space(Trace.FrameCount * 2) & "  |-> Called method: " & Me.GetType.Name & "." & System.Reflection.MethodBase.GetCurrentMethod.Name & "." & vbTab & " Calling method: " & Trace.GetFrame(1).GetMethod().Name)

        SQL_ID = _Connection.GetID(Me)

        If Not _Connection.ObjectIsValid Then
            _ID = _Connection.Insert(Me)
            'trace.writeline("The ID for this Phone is " & _ID)
            Return _ID
        Else
            If _IsDirty Then
                'trace.writeline("This Phone has to be saved")
                _Connection.Update(Me)
            Else
                'trace.writeline("No requirement to save this Phone")
            End If

            _IsDirty = False
            _ID = SQL_ID
            Return _ID 'Me.ID
        End If

    End Function

    ''' <summary>
    ''' Save the Phone details
    ''' </summary>
    ''' <param name="SaveOperation">A ByRef OperationResult so that the caller knows what operation was performed (Update or Insert)</param>
    ''' <returns>The ID of the Phone</returns>
    ''' <remarks></remarks>
    Public Function Save(ByRef SaveOperation As FMDatabase.OperationResult) As Int32
        Dim SQL_ID As Int32 = 0

        SQL_ID = _Connection.GetID(Me)

        If Not _Connection.ObjectIsValid Then
            _ID = _Connection.Insert(Me)

            SaveOperation = FMDatabase.OperationResult.Insert
            Return _ID
        Else
            If _IsDirty Then
                _Connection.Update(Me)
                SaveOperation = FMDatabase.OperationResult.Update
            Else
                SaveOperation = FMDatabase.OperationResult.None
            End If

            _IsDirty = False
            _ID = SQL_ID
            Return _ID
        End If

    End Function

