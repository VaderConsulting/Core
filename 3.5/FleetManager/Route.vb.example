Public Class Route

#Region " Private Declarations "
    Private _PabxID As Integer = 0
    Private _ID As Integer = 0
    Private _Number As String = ""
    Private _Name As String = ""
    Private _TrunkCount As Integer = 0
    Private _Connection As FMConnection
    Private _Comment As String = ""
    Private _AllRoutes As Collections.SortedList
#End Region

#Region " Properties "
    Public Property PabxID As Integer
        Get
            Return _PabxID
        End Get
        Set(ByVal value As Integer)
            _PabxID = value
        End Set
    End Property

    Public Property ID As Integer
        Get
            Return _ID
        End Get
        Set(ByVal value As Integer)
            _ID = value
        End Set
    End Property

    Public Property Number As String
        Get
            Return _Number
        End Get
        Set(ByVal value As String)
            _Number = value
        End Set
    End Property

    Public Property Comment As String
        Get
            Return _Comment
        End Get
        Set(ByVal value As String)
            _Comment = value
        End Set
    End Property

    Public Property Name As String
        Get
            Return _Name
        End Get
        Set(ByVal value As String)
            _Name = value
        End Set
    End Property

    Public Property TrunkCount As Integer
        Get
            Return _TrunkCount
        End Get
        Set(ByVal value As Integer)
            _TrunkCount = value
        End Set
    End Property
#End Region

#Region " Structures "
    Structure RouteStructure
        Dim PabxID As Integer
        Dim ID As Integer
        Dim Number As String
        Dim Name As String
        Dim TrunkCount As Integer
        Dim Comment As String
    End Structure
#End Region

#Region " Methods "

    Public Sub New(ByVal Connection As FMConnection)
        _Connection = Connection
        Dim DataSet As New DataSet
        _AllRoutes = New Collections.SortedList

        DataSet = _Connection.GetAllRoutes()

        Dim ObjectRoute As RouteStructure
        For Each Row As DataRow In DataSet.Tables(0).Rows
            ObjectRoute = New RouteStructure
            ObjectRoute.PabxID = Row("PabxID")
            ObjectRoute.ID = Row("RouteID")
            ObjectRoute.Number = Row("RouteNumber")
            ObjectRoute.Name = Row("RouteName")
            ObjectRoute.Comment = Row("Comment")
            ObjectRoute.TrunkCount = Row("TrunkCount")

            _AllRoutes.Add(_AllRoutes.Count + 1, ObjectRoute)
        Next

    End Sub

    Private Sub GetRouteName(ByVal PabxID As Integer, ByRef RouteName As String)


        For iCounter As Integer = 1 To _AllRoutes.Count
            If CType(_AllRoutes(iCounter), RouteStructure).Name.ToLower = RouteName.ToLower Then
                RouteName = "Route " & CInt(RouteName.Split(" ")(1)) + 1
                GetRouteName(PabxID, RouteName)
            End If
        Next
    End Sub

#End Region

#Region " Functions "
    Private Function CodeExists(ByVal PAbxID As Integer, ByVal RouteNumber As String, ByRef UID As Integer) As Boolean
        For iCounter As Integer = 1 To _AllRoutes.Count
            If CType(_AllRoutes(iCounter), RouteStructure).Number = RouteNumber And CType(_AllRoutes(iCounter), RouteStructure).PabxID = PAbxID Then
                UID =REDACTED RouteStructure).ID
                Return True
            End If
        Next

        Return False
    End Function

    Public Function AddRoute(ByVal PabxID As Integer, ByVal RouteNumber As String) As Integer
        Dim UID As Integer = 0
        Dim RouteName As String = ""

        If Not CodeExists(PabxID, RouteNumber, UID) Then
            _Number = RouteNumber

            If RouteNumber.ToLower.Trim = "route0" Then
                RouteName = "Blank Route"
            Else
                RouteName = "Route " & RouteNumber
            End If
            _Name = RouteName
            _Comment = "Route added by the Call Data Importer"
            _PabxID = PabxID

            UID =REDACTED

            If UID > 0 Then
                Dim ObjectRoute As New RouteStructure
                ObjectRoute.PabxID = PabxID
                ObjectRoute.ID = UID
                ObjectRoute.Number = _Number
                ObjectRoute.Name = _Name
                ObjectRoute.TrunkCount = 0
                ObjectRoute.Comment = _Comment

                _AllRoutes.Add(_AllRoutes.Count + 1, ObjectRoute)
            End If
        End If

        Return UID
    End Function
#End Region

End Class
