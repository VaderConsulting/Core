#Region " Imports "

Imports Core.Compression.Zip
Imports Core.FileTransfer
Imports System
Imports System.IO
Imports System.Net
Imports System.Net.Sockets
Imports System.Text

#End Region

Public Class FTP : Implements IDisposable

#Region " Enums "

    Public Enum ResumeMode
        [Off] = 0
        [On] = 1
    End Enum

    Public Enum TransferMode
        Binary = 1
        Ascii = 2
    End Enum

#End Region

    Private Const BLOCK_SIZE As Integer = 512

#Region " Private Methods "

    Private Sub Cleanup()
        If _ClientSocket IsNot Nothing Then
            _ClientSocket.Close()
            _ClientSocket = Nothing
        End If
        _LoggedIn = False
    End Sub

    Private Function CreateDataSocket() As Socket
        SendCommand("PASV")
        If _ReturnValue <> 227 Then
            Throw New IOException(_Reply.Substring(4))
        End If

        Dim index1 As Integer = _Reply.IndexOf("("c)
        Dim index2 As Integer = _Reply.IndexOf(")"c)
        Dim ipData As String = _Reply.Substring(index1 + 1, index2 - index1 - 1)
        Dim Parts As Integer() = New Integer(5) {}
        Dim ReplyLength As Integer = ipData.Length
        Dim PartCount As Integer = -1
        Dim Buffer As String = ""
        Dim CharacterCounter As Integer = 0

        While CharacterCounter < ReplyLength AndAlso PartCount <= 6
            Dim ThisChar As Char = [Char].Parse(ipData.Substring(CharacterCounter, 1))

            If [Char].IsDigit(ThisChar) Then
                Buffer += ThisChar
            ElseIf ThisChar <> ","c Then
                Throw New IOException("Malformed PASV reply: " & _Reply)
            End If

            If ThisChar = ","c OrElse CharacterCounter + 1 = ReplyLength Then
                Try
                    Parts(System.Math.Max(System.Threading.Interlocked.Increment(PartCount), PartCount - 1)) = Int32.Parse(Buffer)
                    Buffer = ""
                Catch generatedExceptionName As Exception
                    Throw New IOException("Malformed PASV reply: " & _Reply)
                End Try
            End If
            CharacterCounter += 1
        End While

        Dim IPAddress As String = (((CStr(Parts(0)) & ".") + CStr(Parts(1)) & ".") + CStr(Parts(2)) & ".") + CStr(Parts(3))
        Dim Port As Integer = (Parts(4) << 8) + Parts(5)
        Dim DataSocket As New Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp)
        Dim EndPoint As New IPEndPoint(Dns.GetHostEntry(IPAddress).AddressList(0), Port)

        Try
            DataSocket.Connect(EndPoint)
        Catch generatedExceptionName As Exception
            Throw New IOException("Can't connect to remote server")
        End Try

        Return DataSocket
    End Function

    Private Shared Function InlineAssignHelper(Of T)(ByRef target As T, ByVal value As T) As T
        target = value
        Return value
    End Function

    Private Function ReadLine() As String
        While True
            _BytesTransferred = _ClientSocket.Receive(_Buffer, _Buffer.Length, 0)
            _Message = _ASCII.GetString(_Buffer, 0, _BytesTransferred) '& ControlChars.Lf
            If _BytesTransferred < _Buffer.Length Then
                Exit While
            End If
        End While

        Dim Seperator As Char() = {ControlChars.Lf}
        Dim Message As String() = _Message.Split(Seperator)

        If _Message.Length > 2 Then
            _Message = Message(Message.Length - 2)
        Else
            _Message = Message(0)
        End If

        If Not _Message.Substring(3, 1).Equals(" ") Then
            Return ReadLine()
        End If

        If _DebugMode Then
            For k As Integer = 0 To Message.Length - 2
                Trace.WriteLine(Message(k))
            Next
        End If
        Return _Message
    End Function

    Private Sub ReadReply()
        _Message = ""
        _Reply = ReadLine()
        _ReturnValue = Int32.Parse(_Reply.Substring(0, 3))
    End Sub

    Private Sub SendCommand(ByVal Command As String)
        Dim cmdBytes As Byte() = Encoding.ASCII.GetBytes((Command & vbCr & vbLf).ToCharArray())

        _ClientSocket.Send(cmdBytes, cmdBytes.Length, 0)
        ReadReply()
    End Sub

#End Region

#Region " Private Variables "

    Private _ASCII As Encoding = Encoding.ASCII
    Private _Buffer As Byte() = New Byte(BLOCK_SIZE - 1) {}
    Private _BytesTransferred As Integer = 0
    Private _ClientSocket As Socket = Nothing
    Private _DebugMode As Boolean = False
    Private _LoggedIn As Boolean = False
    Private _Message As String = ""
    Private _RemoteHost As String = ""
    Private _RemotePassword As String = ""
    Private _RemotePath As String = ""
    Private _RemotePort As Integer = 21
    Private _RemoteUsername As String = ""
    Private _Reply As String = ""
    Private _ReturnValue As Integer = 0
    Private _UseCompression As Boolean = True

#End Region

#Region " Properties "

    ''' <summary>
    ''' Debug mode
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Property DebugMode() As Boolean
        Get
            Return _DebugMode
        End Get
        Set(ByVal value As Boolean)
            _DebugMode = value
        End Set
    End Property

    ''' <summary>
    ''' Name of the FTP server to connect to
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Property RemoteHost() As String
        Get
            Return _RemoteHost
        End Get
        Set(ByVal value As String)
            _RemoteHost = value
        End Set
    End Property

    ''' <summary>
    ''' Password to user for logging into the remote server
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Property RemotePassword() As String
        Get
            Return _RemotePassword
        End Get
        Set(ByVal value As String)
            _RemotePassword =REDACTED
        End Set
    End Property

    ''' <summary>
    ''' Remote directory path
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Property RemotePath() As String
        Get
            Return _RemotePath
        End Get
        Set(ByVal value As String)
            _RemotePath = value.Replace("\", "/")
        End Set
    End Property

    ''' <summary>
    ''' Port number to use for FTP
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Property RemotePort() As Integer
        Get
            Return _RemotePort
        End Get
        Set(ByVal value As Integer)
            _RemotePort = value
        End Set
    End Property

    ''' <summary>
    ''' User name to use for logging into the remote server
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Property RemoteUsername() As String
        Get
            Return _RemoteUsername
        End Get
        Set(ByVal value As String)
            _RemoteUsername = value
        End Set
    End Property

    ''' <summary>
    ''' Compression
    ''' </summary>
    ''' <value></value>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Property UseCompression() As Boolean
        Get
            Return _UseCompression
        End Get
        Set(ByVal value As Boolean)
            _UseCompression = value
        End Set
    End Property

#End Region

#Region " Public Methods "

    ''' <summary>
    ''' Change the current working directory on the remote FTP server
    ''' </summary>
    ''' <param name="DirectoryName"></param>
    ''' <remarks></remarks>
    Public Sub ChangeRemoteDirectory(ByVal DirectoryName As String)
        If DirectoryName.Equals(".") Then
            Exit Sub
        End If
        If Not _LoggedIn Then
            Login()
        End If
        SendCommand("CWD " & DirectoryName)
        If _ReturnValue <> 250 Then
            Throw New IOException(_Reply.Substring(4))
        End If
        Me._RemotePath = DirectoryName
        Trace.WriteLine("Current directory is " & _RemotePath)
    End Sub

    ''' <summary>
    ''' Close the FTP connection
    ''' </summary>
    ''' <remarks></remarks>
    Public Sub Close()
        Trace.WriteLine("Closing...")
        If _ClientSocket IsNot Nothing Then
            SendCommand("QUIT")
        End If

        Cleanup()
    End Sub

    ''' <summary>
    ''' Create a directory on the remote FTP server
    ''' </summary>
    ''' <param name="DirectoryName"></param>
    ''' <remarks></remarks>
    Public Sub CreateRemoteDirectory(ByVal DirectoryName As String)
        If Not _LoggedIn Then
            Login()
        End If

        SendCommand("MKD " & DirectoryName)

        If _ReturnValue > 400 Then
            Trace.WriteLine("MKD failed (" & _Reply.Substring(4) & ")")
            Throw New IOException(_Reply.Substring(4))
        End If
    End Sub

    ''' <summary>
    ''' Delete a directory on the remote FTP server
    ''' </summary>
    ''' <param name="DirectoryName"></param>
    ''' <remarks></remarks>
    Public Sub DeleteRemoteDirectory(ByVal DirectoryName As String)
        If Not _LoggedIn Then
            Login()
        End If
        SendCommand("RMD " & DirectoryName)
        If _ReturnValue <> 250 Then
            Throw New IOException(_Reply.Substring(4))
        End If
    End Sub

    ''' <summary>
    ''' Delete a file from the remote FTP server
    ''' </summary>
    ''' <param name="Filename"></param>
    ''' <remarks></remarks>
    Public Sub DeleteRemoteFile(ByVal Filename As String)
        If Not _LoggedIn Then
            Login()
        End If
        SendCommand("DELE " & Filename)
        If _ReturnValue <> 250 Then
            Throw New IOException(_Reply.Substring(4))
        End If
    End Sub

    ''' <summary>
    ''' Implements IDisposable.Dispose
    ''' </summary>
    ''' <remarks></remarks>
    Public Sub Dispose() Implements IDisposable.Dispose
        Cleanup()
        MyBase.Finalize()
    End Sub

    ''' <summary>
    ''' Download a file to the Assembly's local directory, keeping the same file name
    ''' </summary>
    ''' <param name="RemoteFilename"></param>
    ''' <remarks></remarks>
    Public Sub Download(ByVal RemoteFilename As String)
        Download(RemoteFilename, "", ResumeMode.Off)
    End Sub

    ''' <summary>
    ''' Download a remote file to the Assembly's local directory, keeping the same file name, and set the resume flag
    ''' </summary>
    ''' <param name="RemoteFilename"></param>
    ''' <param name="Resume"></param>
    ''' <remarks></remarks>
    Public Sub Download(ByVal RemoteFilename As String, ByVal [Resume] As ResumeMode)
        Download(RemoteFilename, "", [Resume])
    End Sub

    ''' <summary>
    ''' Download a remote file to a local file name which can include a path. The local file name will be created or overwritten, but the path must exist.
    ''' </summary>
    ''' <param name="RemoteFilename"></param>
    ''' <param name="LocalFilename"></param>
    ''' <remarks></remarks>
    Public Sub Download(ByVal RemoteFilename As String, ByVal LocalFilename As String)
        Download(RemoteFilename, LocalFilename, ResumeMode.Off)
    End Sub

    ''' <summary>
    ''' Download a remote file to a local file name which can include a path, and set the resume flag. The local file name will be created or overwritten, but the path must exist.
    ''' </summary>
    ''' <param name="RemoteFilename"></param>
    ''' <param name="LocalFilename"></param>
    ''' <param name="Resume"></param>
    ''' <remarks></remarks>
    Public Sub Download(ByVal RemoteFilename As String, ByVal LocalFilename As String, ByVal [Resume] As ResumeMode)
        If Not _LoggedIn Then
            Login()
        End If

        SetMode(TransferMode.Binary)
        Trace.WriteLine((("Downloading file " & RemoteFilename & " from ") + _RemoteHost & "/") + _RemotePath)

        If LocalFilename.Length = 0 Then
            LocalFilename = RemoteFilename
        End If

        If Not File.Exists(LocalFilename) Then
            Dim st As Stream = File.Create(LocalFilename)
            st.Close()
        End If

        Dim Output As New FileStream(LocalFilename, FileMode.Open)
        Dim cSocket As Socket = CreateDataSocket()
        Dim Offset As Long = 0

        If [Resume] = ResumeMode.On Then
            Offset = Output.Length
            If Offset > 0 Then
                SendCommand("REST " & Offset)
                If _ReturnValue <> 350 Then
                    'throw new IOException(reply.Substring(4));
                    'Some servers may not support resuming.
                    Offset = 0
                End If
            End If
            If Offset > 0 Then
                If _DebugMode Then
                    Trace.WriteLine("seeking to " & Offset)
                End If
                Dim npos As Long = Output.Seek(Offset, SeekOrigin.Begin)
                Trace.WriteLine("new pos=" & npos)
            End If
        End If

        SendCommand("RETR " & RemoteFilename)
        If Not (_ReturnValue = 150 OrElse _ReturnValue = 125) Then
            Throw New IOException(_Reply.Substring(4))
        End If

        While True
            _BytesTransferred = cSocket.Receive(_Buffer, _Buffer.Length, 0)
            Output.Write(_Buffer, 0, _BytesTransferred)
            If _BytesTransferred <= 0 Then
                Exit While
            End If
        End While

        Output.Close()
        If cSocket.Connected Then
            cSocket.Close()
        End If

        Trace.WriteLine("")
        ReadReply()

        If Not (_ReturnValue = 226 OrElse _ReturnValue = 250) Then
            Throw New IOException(_Reply.Substring(4))
        Else
            If _UseCompression Then DecompressFile(LocalFilename)
        End If
    End Sub

    ''' <summary>
    ''' Return a string array containing the remote directory's file list
    ''' </summary>
    ''' <param name="mask"></param>
    ''' <returns>String array</returns>
    ''' <remarks></remarks>
    Public Function GetFileList(ByVal Mask As String) As String()
        If Not _LoggedIn Then
            Login()
        End If

        Dim cSocket As Socket = CreateDataSocket()

        SendCommand("NLST " & Mask)
        If Not (_ReturnValue = 150 OrElse _ReturnValue = 125) Then
            Throw New IOException(_Reply.Substring(4))
        End If

        _Message = ""
        While True
            Dim bytes As Integer = cSocket.Receive(_Buffer, _Buffer.Length, 0)
            _Message += _ASCII.GetString(_Buffer, 0, bytes)
            If bytes < _Buffer.Length Then
                Exit While
            End If
        End While

        Dim Separator As Char() = {ControlChars.Lf}
        Dim Message As String() = _Message.Split(Separator)

        cSocket.Close()
        ReadReply()
        If _ReturnValue <> 226 Then
            Throw New IOException(_Reply.Substring(4))
        End If

        Return Message
    End Function

    ''' <summary>
    ''' Return the size of a file
    ''' </summary>
    ''' <param name="fileName"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetFileSize(ByVal FileName As String) As Long
        If Not _LoggedIn Then
            Login()
        End If

        Dim fi As New FileInfo(FileName)

        SendCommand("SIZE " & fi.Name)
        Dim size As Long = 0

        If _ReturnValue = 213 Then
            size = Int64.Parse(_Reply.Substring(4))
        Else
            Trace.WriteLine("GetFileSize failed: " & _Reply.Substring(4).Replace(vbCr, ""))
            'Throw New IOException(m_Reply.Substring(4))
        End If

        Return size
    End Function

    ''' <summary>
    ''' Login to the remote server
    ''' </summary>
    ''' <remarks></remarks>
    Public Sub Login()
        _ClientSocket = New Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp)

        Dim ep As New IPEndPoint(Dns.GetHostEntry(_RemoteHost).AddressList(0), _RemotePort)

        Try
            _ClientSocket.Connect(ep)
        Catch generatedExceptionName As Exception
            Debug.Print("Login failed (" & generatedExceptionName.Message & ")")
            Throw New IOException("Couldn't connect to remote server")
        End Try

        ReadReply()
        If _ReturnValue <> 220 Then
            Close()
            Throw New IOException(_Reply.Substring(4))
        End If

        Debug.Print("USER " & _RemoteUsername)

        SendCommand("USER " & _RemoteUsername)
        If Not (_ReturnValue = 331 OrElse _ReturnValue = 230) Then
            Cleanup()
            Throw New IOException(_Reply.Substring(4))
        End If

        If _ReturnValue <> 230 Then
            Debug.Print("PASS xxx")
            SendCommand("PASS " & _RemotePassword)
            If Not (_ReturnValue = 230 OrElse _ReturnValue = 202) Then
                Cleanup()
                Throw New IOException(_Reply.Substring(4))
            End If
        End If

        ' Adjust the remote path to ensure it fits the URI laws
        _RemotePath = _RemotePath.Replace("\", "/")

        _LoggedIn = True
        Debug.Print("Connected to " & _RemoteHost)
        Try
            ChangeRemoteDirectory(_RemotePath)
        Catch
            CreateRemoteDirectory(_RemotePath)
            ChangeRemoteDirectory(_RemotePath)
        End Try
    End Sub

    ''' <summary>
    ''' Rename a file on the remote FTP server
    ''' </summary>
    ''' <param name="OldFilename"></param>
    ''' <param name="NewFilename"></param>
    ''' <remarks></remarks>
    Public Sub RenameRemoteFile(ByVal OldFilename As String, ByVal NewFilename As String)
        If Not _LoggedIn Then
            Login()
        End If
        SendCommand("RNFR " & OldFilename)
        If _ReturnValue <> 350 Then
            Throw New IOException(_Reply.Substring(4))
        End If
        ' known problem
        ' rnto will not take care of existing file.
        ' i.e. It will overwrite if newFileName exist
        SendCommand("RNTO " & NewFilename)
        If _ReturnValue <> 250 Then
            Throw New IOException(_Reply.Substring(4))
        End If
    End Sub

    ''' <summary>
    ''' Set binary mode for downloads, otherwise, set Ascii mode
    ''' </summary>
    ''' <param name="mode"></param>
    ''' <remarks></remarks>
    Public Sub SetMode(ByVal Mode As TransferMode)
        Select Case Mode
            Case TransferMode.Ascii
                SendCommand("TYPE A")
            Case TransferMode.Binary
                SendCommand("TYPE I")
        End Select

        If _ReturnValue <> 200 Then
            Throw New IOException(_Reply.Substring(4))
        End If
    End Sub

    ''' <summary>
    ''' Upload a file with Resume set to off
    ''' </summary>
    ''' <param name="fileName"></param>
    ''' <remarks></remarks>
    Public Sub Upload(ByVal Filename As String)
        Upload(Filename, "", False)
    End Sub

    ''' <summary>
    ''' Upload a file to the given filename with Resume set to off
    ''' </summary>
    ''' <param name="fileName"></param>
    ''' <remarks></remarks>
    Public Sub Upload(ByVal Filename As String, ByVal DestinationFilename As String)
        Upload(Filename, DestinationFilename, False)
    End Sub

    ''' <summary>
    ''' Upload a file to the given filename and set the resume option
    ''' </summary>
    ''' <param name="fileName"></param>
    ''' <param name="resume"></param>
    ''' <remarks></remarks>
    Public Sub Upload(ByVal Filename As String, ByVal DestinationFilename As String, ByVal [Resume] As ResumeMode)
        Dim FileToUpload As String = ""

        If Not _LoggedIn Then
            Login()
        End If

        If _UseCompression Then
            CompressFile(Filename, DestinationFilename, True, False)
            FileToUpload = DestinationFilename
        Else
            ' Update 08 Jul 2013 - DR
            ' DestinationFilename = Filename  
            FileToUpload = Filename
            ' End update
        End If

        ' Dim FileToUpload As String = Filename ' DestinationFilename
        Dim DataSocket As Socket = CreateDataSocket()
        Dim Offset As Long = 0

        If [Resume] = ResumeMode.On Then
            Try
                SetMode(TransferMode.Binary)
                Try
                    Offset = GetFileSize(FileToUpload)
                Catch ex As Exception
                    ' Ignore
                    Trace.WriteLine("Error retrieving Filesize of " & FileToUpload & ".  Resume now set to 'Off'.")
                    [Resume] = ResumeMode.Off
                    Offset = 0
                End Try
            Catch generatedExceptionName As Exception
                Offset = 0
            End Try
        End If

        If Offset > 0 Then
            SendCommand("REST " & Offset)
            If _ReturnValue <> 350 Then
                'throw new IOException(reply.Substring(4));
                'Remote server may not support resuming.
                Trace.WriteLine("Remote Server does not support resume.")
                Offset = 0
            End If
        End If

        SendCommand("STOR " & Path.GetFileName(FileToUpload))
        If Not (_ReturnValue = 125 OrElse _ReturnValue = 150) Then
            Throw New IOException(_Reply.Substring(4))
        End If

        ' open input stream to read source file
        Dim Input As New FileStream(FileToUpload, FileMode.Open)

        If Offset <> 0 Then
            If _DebugMode Then
                Trace.WriteLine("seeking to " & Offset)
            End If
            Input.Seek(Offset, SeekOrigin.Begin)
        End If

        Trace.WriteLine(("Uploading file " & FileToUpload & " to ") + _RemotePath)
        While (InlineAssignHelper(_BytesTransferred, Input.Read(_Buffer, 0, _Buffer.Length))) > 0
            DataSocket.Send(_Buffer, _BytesTransferred, 0)
        End While

        Input.Close()
        Trace.WriteLine("")
        If DataSocket.Connected Then
            DataSocket.Close()
        End If
        ReadReply()
        If Not (_ReturnValue = 226 OrElse _ReturnValue = 250) Then
            Throw New IOException(_Reply.Substring(4))
        End If
    End Sub

#End Region

End Class
