Public Class Trunk

#Region " Private Declarations "
    Private _RouteID As Integer = 0
    Private _ID As Integer = 0
    Private _Number As String = ""
    Private _Name As String = ""
    Private _Comment As String = ""
    Private _Connection As FMConnection
    Private _AllTrunks As Collections.SortedList
#End Region

#Region " Properties "

    Public Property RouteID As Integer
        Get
            Return _RouteID
        End Get
        Set(ByVal value As Integer)
            _RouteID = value
        End Set
    End Property

    Public Property ID As Integer
        Get
            Return _ID
        End Get
        Set(ByVal value As Integer)
            _ID = value
        End Set
    End Property

    Public Property Number As String
        Get
            Return _Number
        End Get
        Set(ByVal value As String)
            _Number = value
        End Set
    End Property

    Public Property Name As String
        Get
            Return _Name
        End Get
        Set(ByVal value As String)
            _Name = value
        End Set
    End Property

    Public Property Comment As String
        Get
            Return _Comment
        End Get
        Set(ByVal value As String)
            _Comment = value
        End Set
    End Property

#End Region

#Region " Structures "
    Structure TrunkStructure
        Dim RouteID As Integer
        Dim ID As Integer
        Dim Number As String
        Dim Name As String
        Dim Comment As String
    End Structure
#End Region


    Public Sub New(ByVal Connection As FMConnection)
        _Connection = Connection
        Dim Dataset As New DataSet
        _AllTrunks = New Collections.SortedList

        Dataset = _Connection.GetAllTrunks

        Dim ObjectTrunk As TrunkStructure
        For Each Row As DataRow In Dataset.Tables(0).Rows
            ObjectTrunk = New TrunkStructure
            ObjectTrunk.RouteID = Row("RouteID")
            ObjectTrunk.ID = Row("TrunkID")
            ObjectTrunk.Number = Row("TrunkNumber")
            ObjectTrunk.Name = Row("TrunkName")
            ObjectTrunk.Comment = Row("Comment")


            _AllTrunks.Add(_AllTrunks.Count + 1, ObjectTrunk)
        Next

    End Sub

    Private Sub GetTrunkName(ByVal RouteID As Integer, ByRef TrunkName As String)

        For iCounter As Integer = 1 To _AllTrunks.Count
            If CType(_AllTrunks(iCounter), TrunkStructure).Name.ToLower = TrunkName.ToLower Then
                TrunkName = "Trunk " & CInt(TrunkName.Split(" ")(1)) + 1
                GetTrunkName(RouteID, TrunkName)
            End If
        Next
    End Sub

#Region " Functions "

    Private Function CodeExists(ByVal RouteID As Integer, ByVal TrunkNumber As String, ByRef UID As Integer) As Boolean
        For iCounter As Integer = 1 To _AllTrunks.Count
            If CType(_AllTrunks(iCounter), TrunkStructure).Number = TrunkNumber And CType(_AllTrunks(iCounter), TrunkStructure).RouteID = RouteID Then
                UID =REDACTED TrunkStructure).ID
                Return True
            End If
        Next

        Return False
    End Function

    Public Function AddTrunk(ByVal RouteID As Integer, ByVal TrunkNumber As String) As Integer
        Dim UID As Integer = 0
        Dim TrunkName As String = ""

        If Not CodeExists(RouteID, TrunkNumber, UID) Then
            _Number = TrunkNumber
            If TrunkNumber.ToLower.Trim = "trunk0" Then
                TrunkName = "Blank Trunk"
            Else
                TrunkName = "Trunk " & TrunkNumber
            End If
            _Name = TrunkName
            _Comment = "Trunk added by the Call Data Importer"
            _RouteID = RouteID

            UID =REDACTED

            If UID > 0 Then
                Dim ObjectTrunk As New TrunkStructure
                ObjectTrunk.RouteID = RouteID
                ObjectTrunk.ID = UID
                ObjectTrunk.Number = _Number
                ObjectTrunk.Name = _Name
                ObjectTrunk.Comment = _Comment

                _AllTrunks.Add(_AllTrunks.Count + 1, ObjectTrunk)

            End If

            _Connection.UpdateTrunkCount(RouteID)
        End If


        Return UID
    End Function




#End Region

End Class
